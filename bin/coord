class Fail(Exception):
    pass


# ---------------------------------------------------------------- utilities

def now():
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def argv(cmd):
    # CreateProcess finds only .exe files on PATH, so npx.cmd and the like are resolved first
    args = [str(c) for c in cmd]
    if WINDOWS and args:
        args[0] = shutil.which(args[0]) or args[0]
    return args


def spawn(cmd, **kw):
    """Start a process that outlives this one, in its own session (its own process group on Windows)."""
    cmd = argv(cmd) if isinstance(cmd, list) else cmd
    if not WINDOWS:
        return subprocess.Popen(cmd, start_new_session=True, **kw)
    flags = subprocess.CREATE_NEW_PROCESS_GROUP | subprocess.CREATE_NO_WINDOW
    try:
        return subprocess.Popen(cmd, creationflags=flags | subprocess.CREATE_BREAKAWAY_FROM_JOB, **kw)
    except OSError:  # the caller's job object doesn't allow breakaway
        return subprocess.Popen(cmd, creationflags=flags, **kw)


def coord_argv():
    return [sys.executable] + (["-X", "utf8"] if WINDOWS else []) + [str(ROOT / "bin" / "coord")]


def git_bash():
    env = os.environ.get("CLAUDE_CODE_GIT_BASH_PATH")
    if env and Path(env).is_file():
        return env
    g = shutil.which("git")
    for up in Path(g).resolve().parents[1:3] if g else ():
        if (up / "bin" / "bash.exe").is_file():
            return str(up / "bin" / "bash.exe")
    return None


def sh(cmd):
    """How to run a config command (setup, gate, dev): with sh, or Git Bash on Windows, so one command works on both."""
    bash = git_bash() if WINDOWS else None
    return ([bash, "-c", cmd], False) if bash else (cmd, True)


def run(cmd, cwd=None, env=None, check=True):
    r = subprocess.run(argv(cmd), cwd=cwd and str(cwd), env=env, text=True, capture_output=True)
    if check and r.returncode != 0:
        msg = (r.stderr or r.stdout).strip()[-800:]
        raise Fail("`%s` failed: %s" % (" ".join(str(c) for c in cmd[:4]), msg))
    return r


def git(cwd, *args, check=True):
    return run(["git", *args], cwd=cwd, check=check).stdout.strip()


def read_json(path, default=None):
    for i in range(40):
        try:
            return json.loads(Path(path).read_text())
        except (FileNotFoundError, ValueError):
            return default
        except PermissionError:  # Windows, while a writer replaces the file
            if not WINDOWS or i == 39:
                raise
            time.sleep(0.05)


def write_json(path, data):
    path = Path(path)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
    for i in range(100):
        try:
            os.replace(tmp, path)
            return
        except PermissionError:  # Windows refuses while a reader has the file open
            if not WINDOWS or i == 99:
                raise
            time.sleep(0.05)


def nonempty(path):
    p = Path(path)
    return p.exists() and p.read_text().strip() != ""


def remove_tree(path):
    """Delete a folder. On errors, make everything in it writable and try again; returns what is still there."""
    path = Path(path)
    shutil.rmtree(path, ignore_errors=True)
    if not path.exists():
        return []

    def writable(p):
        if not p.is_symlink():
            try:
                os.chmod(p, stat.S_IMODE(p.lstat().st_mode) | (stat.S_IRWXU if p.is_dir() else stat.S_IRUSR | stat.S_IWUSR))
            except OSError:
                pass

    writable(path)
    for root, dirs, files in os.walk(path):  # top-down: a folder is made readable before the walk enters it
        for n in dirs + files:
            writable(Path(root) / n)
    shutil.rmtree(path, ignore_errors=True)
    if not path.exists():
        return []
    return [str(Path(root) / n) for root, dirs, files in os.walk(path) for n in files] or [str(path)]


@contextmanager
def locked(path):
    with open(path, "a+") as f:
        if not WINDOWS:
            fcntl.flock(f, fcntl.LOCK_EX)
            yield
            return
        f.seek(0)
        while True:
            try:
                msvcrt.locking(f.fileno(), msvcrt.LK_NBLCK, 1)
                break
            except OSError:
                time.sleep(0.05)
        try:
            yield
        finally:
            f.seek(0)
            msvcrt.locking(f.fileno(), msvcrt.LK_UNLCK, 1)


def slug(text, n=40):
    s = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return s[:n].strip("-") or "run"


def proc_start(pid):
    """When a process started, as a number that only means something for comparison; "" when unknown."""
    if not pid:
        return ""
    if WINDOWS:
        try:
            h = kernel32.OpenProcess(0x1000, False, int(pid))
        except (ValueError, OverflowError, TypeError):
            return ""
        if not h:
            return ""
        times = [ctypes.c_ulonglong() for _ in range(4)]
        ok = kernel32.GetProcessTimes(h, *[ctypes.byref(t) for t in times])
        kernel32.CloseHandle(h)
        return str(times[0].value) if ok else ""
    try:
        return Path("/proc/%d/stat" % int(pid)).read_text().rsplit(")", 1)[1].split()[19]
    except (OSError, IndexError, ValueError):
        pass
    r = subprocess.run(["ps", "-o", "lstart=", "-p", str(int(pid))], capture_output=True, text=True)
    return r.stdout.strip()


def alive(pid, start=""):
    """True while the process runs. With `start` (from proc_start), a reused pid doesn't count."""
    if not pid:
        return False
    if WINDOWS:  # os.kill(pid, 0) would terminate the process here
        try:
            h = kernel32.OpenProcess(0x1000, False, int(pid))  # PROCESS_QUERY_LIMITED_INFORMATION
        except (ValueError, OverflowError, TypeError):
            return False
        if not h:
            return False
        code = ctypes.c_ulong()
        ok = kernel32.GetExitCodeProcess(h, ctypes.byref(code))
        kernel32.CloseHandle(h)
        if not (bool(ok) and code.value == 259):  # STILL_ACTIVE
            return False
    else:
        try:
            os.kill(int(pid), 0)
        except (OSError, ValueError):
            return False
    return not start or proc_start(pid) in ("", start)


def try_lock(path):
    """An exclusive lock held for as long as the returned file stays open; None when another process holds it."""
    f = open(path, "a+")
    try:
        if WINDOWS:
            f.seek(0)
            msvcrt.locking(f.fileno(), msvcrt.LK_NBLCK, 1)
        else:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return f
    except OSError:
        f.close()
        return None


def kill_group(pid, grace=5.0, start=""):
    if not alive(pid, start):  # with `start`, a pid the system gave to another process since is left alone
        return
    if WINDOWS:
        subprocess.run(["taskkill", "/T", "/F", "/PID", str(int(pid))], capture_output=True)
        end = time.time() + grace
        while time.time() < end and alive(pid):
            time.sleep(0.2)
        return
    for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(int(pid), sig)
        except OSError:
            try:
                os.kill(int(pid), sig)
            except OSError:
                return
        end = time.time() + grace
        while time.time() < end and alive(pid):
            time.sleep(0.2)
        if not alive(pid):
            return


TOAST = r"""$ErrorActionPreference = 'SilentlyContinue'
[Windows.UI.Notifications.ToastNotificationManager, Windows.UI.Notifications, ContentType = WindowsRuntime] > $null
$t = [Windows.UI.Notifications.ToastNotificationManager]::GetTemplateContent([Windows.UI.Notifications.ToastTemplateType]::ToastText02)
$x = $t.GetElementsByTagName('text')
$x.Item(0).AppendChild($t.CreateTextNode($env:COORD_TOAST_TITLE)) > $null
$x.Item(1).AppendChild($t.CreateTextNode($env:COORD_TOAST_TEXT)) > $null
$id = '{1AC14E77-02E7-4E5D-B744-2EB1AE5198B7}\WindowsPowerShell\v1.0\powershell.exe'
[Windows.UI.Notifications.ToastNotificationManager]::CreateToastNotifier($id).Show([Windows.UI.Notifications.ToastNotification]::new($t))
"""


def notify(title, text):
    try:
        if sys.platform == "darwin":
            script = "display notification %s with title %s" % (json.dumps(text), json.dumps(title))
            subprocess.run(["osascript", "-e", script], capture_output=True, timeout=10)
        elif WINDOWS:
            import base64
            encoded = base64.b64encode(TOAST.encode("utf-16-le")).decode()
            spawn(["powershell", "-NoProfile", "-NonInteractive", "-EncodedCommand", encoded], stdout=subprocess.DEVNULL,
                  stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
                  env=dict(os.environ, COORD_TOAST_TITLE=title[:120], COORD_TOAST_TEXT=text[:300]))
        elif shutil.which("notify-send"):
            subprocess.run(["notify-send", title, text], capture_output=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        pass


def open_url(url):
    if WINDOWS:
        os.startfile(url)
        return
    opener = "open" if sys.platform == "darwin" else "xdg-open"
    if shutil.which(opener):
        subprocess.run([opener, url], capture_output=True)


def free_port(preferred=0):
    for port in (preferred, 0) if preferred else (0,):
        s = socket.socket()
        try:
            s.bind(("127.0.0.1", port))
            return s.getsockname()[1]
        except OSError:
            continue
        finally:
            s.close()
    raise Fail("no free port")


def human_minutes(m):
    m = int(round(m or 0))
    return "%dh %02dm" % (m // 60, m % 60) if m >= 60 else "%dm" % m


def human_tokens(n):
    n = n or 0
    return "%.1fM" % (n / 1e6) if n >= 1e6 else "%dK" % (n / 1e3) if n >= 1e3 else str(n)


def png_size(path):
    with open(path, "rb") as f:
        head = f.read(24)
    return int.from_bytes(head[16:20], "big"), int.from_bytes(head[20:24], "big")


def is_test_file(cfg, path):
    import fnmatch
    parts = Path(path).parts
    if any(fnmatch.fnmatch(parts[-1], pat) for pat in cfg.get("test_names", [])):
        return True
    return any(d in cfg.get("test_dirs", []) or d.endswith("Tests") or d.endswith(".Tests") for d in parts[:-1])


TEST_DECL = re.compile(r"\b(it|test|describe|context|specify|suite)(\.\w+)?\s*\(|\bdef test_|@Test\b|\[(Fact|Theory|Test|TestMethod)\]|\bfunc Test")


def test_edit_lines(path, tool, ti):
    """How many lines an edit to an existing test file changes, or None when it adds a test or creates the file."""
    import difflib
    try:
        current = Path(path).read_text(errors="replace")
    except OSError:
        return None
    if tool == "Write":
        pairs = [(current, ti.get("content") or "")]
    elif tool == "MultiEdit":
        pairs = [(e.get("old_string") or "", e.get("new_string") or "") for e in ti.get("edits") or []]
    else:
        pairs = [(ti.get("old_string") or "", ti.get("new_string") or "")]
    n = 0
    for old, new in pairs:
        if len(TEST_DECL.findall(new)) > len(TEST_DECL.findall(old)):
            return None
        diff = [x for x in difflib.ndiff(old.splitlines(), new.splitlines()) if x[:1] in "+-" and x[2:].strip()]
        n += max(sum(1 for x in diff if x[0] == "+"), sum(1 for x in diff if x[0] == "-"))
    return n


GATE_ERROR = re.compile(r"error|Error|ERROR|FAIL|Failed|failed|✕|✗|TS\d{4}|Traceback|panicked|exception", re.I)


def gate_excerpt(text, cap=150):
    """The error blocks of a gate log with a little context: the real error is often far from the tail."""
    lines = text.splitlines()
    hits = [i for i, x in enumerate(lines) if GATE_ERROR.search(x)][:40]
    if not hits:
        return "\n".join(lines[-60:])
    keep = sorted({j for i in hits for j in range(max(0, i - 3), min(len(lines), i + 4))})
    out, last = [], -2
    for j in keep:
        if j != last + 1:
            out.append("...")
        out.append(lines[j])
        last = j
    return "\n".join(out[:cap])


def gate_signature(text):
    """The failing lines of a gate log without numbers, durations or paths, to tell a known failure from a new one."""
    sig = set()
    for x in text.splitlines():
        if GATE_ERROR.search(x):
            x = re.sub(r"[A-Za-z]:[\\/][^\s:]*|/[^\s:]*/", "", x)
            sig.add(re.sub(r"\d+(\.\d+)?", "#", x).strip())
    return sig


def owner_words(data):
    lines = [data["request"]]
    for n in data.get("owner_notes", []):
        where = " (to %s)" % n["task"] if n.get("task") else ""
        lines.append("\n[%s, %s%s] %s" % (n["at"][:16], n["kind"], where, n["text"]))
    return "\n".join(lines)


def add_owner_note(data, kind, text, task=""):
    data.setdefault("owner_notes", []).append({"at": now(), "kind": kind, "task": task, "text": text})


def changed_files(wt, branch):
    run(["git", "add", "-A", "-N"], cwd=wt, check=False)
    out = run(["git", "diff", "--name-only", branch], cwd=wt, check=False).stdout
    return [x for x in out.splitlines() if x.strip()]


INSTRUCTION_NAMES = ("CLAUDE.md", "AGENTS.md", "CLAUDE.local.md", ".claude/CLAUDE.md")


def project_instructions(project):
    """The instruction files the owner's own Claude Code session would load for this project, outermost first,
    and the folders that hold them. Read from the main folder, so uncommitted edits count."""
    chain, d, home = [], Path(project).resolve(), Path.home().resolve()
    while True:
        chain.append(d)
        if d == home or d.parent == d:
            break
        d = d.parent
    files, dirs, seen = [], [], set()
    for d in reversed(chain):
        found = [d / n for n in INSTRUCTION_NAMES if (d / n).is_file()]
        rules = sorted((d / ".claude" / "rules").glob("*.md")) if (d / ".claude" / "rules").is_dir() else []
        new = []
        for f in found + rules:
            if f.resolve() not in seen:
                seen.add(f.resolve())
                new.append(f)
        if new:
            files += new
            dirs.append(d)
    return files, dirs


def instructions_block(r, role):
    files, _ = project_instructions(r.project)
    shell = ["Your Bash tool is Git Bash on Windows: write paths in commands with forward slashes (C:/dir/file)."]         if WINDOWS else []
    if not files:
        return shell + ["Project instructions: none found."]
    lines = shell + ["Project instructions: Claude Code has already loaded these into your context, so don't open them "
                     "again. They are the owner's current versions and win wherever they and your role disagree:"]
    lines += ["- %s" % f for f in files]
    if role in ("builder", "officer"):
        lines.append("Steps they ask of every new session to get oriented (reading an index, a README or a product "
                     "page) were done by the planner, which put what you need in your brief. Open such a file only "
                     "when your brief names it or you need a fact from it.")
    if role == "builder":
        lines.append("Your worktree holds the committed copies of the project's files; where they differ from the "
                     "files above, the files above win.")
    lines.append("Coordinator commits your work on the run branch and pushes it, which is how a project rule to "
                 "commit or push is met in a run. Don't ask the owner about it.")
    return lines


def load_config(project):
    cfg = json.loads(json.dumps(DEFAULTS))
    user = read_json(Path(project) / STORE / "config.json", {}) or {}
    for k, v in user.items():
        if isinstance(v, dict) and isinstance(cfg.get(k), dict):
            cfg[k].update(v)
        else:
            cfg[k] = v
    return cfg


def project_root(start=None):
    if os.environ.get("COORD_PROJECT"):
        return Path(os.environ["COORD_PROJECT"])
    r = run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"], cwd=start or os.getcwd(), check=False)
    if r.returncode:
        raise Fail("not inside a git repository")
    return Path(r.stdout.strip()).parent


# ---------------------------------------------------------------- the run

class Run:
    def __init__(self, project, name):
        self.project = Path(project).resolve()
        self.name = name
        self.dir = self.project / STORE / name
        key = hashlib.sha1(str(self.project).encode()).hexdigest()[:6]
        self.brain = HOME / "runs" / ("%s-%s--%s" % (slug(self.project.name, 24), key, name))
        self.cfg = load_config(self.project)

    @property
    def tasks_file(self):
        return self.dir / "tasks.json"

    def load(self):
        data = read_json(self.tasks_file)
        if data is None:
            raise Fail("no coordinator named %r in %s" % (self.name, self.project / STORE))
        return data

    @contextmanager
    def edit(self):
        with locked(self.dir / ".lock"):
            data = self.load()
            yield data
            data["updated"] = now()
            write_json(self.tasks_file, data)

    def state(self):
        return read_json(self.brain / "run.json", {}) or {}

    def set_state(self, **kw):
        self.brain.mkdir(parents=True, exist_ok=True)
        with locked(self.brain / ".lock"):
            st = self.state()
            st.update(kw)
            write_json(self.brain / "run.json", st)
            return st

    def task_dir(self, tid):
        return self.dir / "tasks" / tid

    def task_branch(self, tid):
        return "coord-tasks/%s/%s" % (self.name, tid)

    def wt(self, tid):
        return self.brain / "wt" / tid

    def alive(self, which):
        """The scheduler or the viewer is running, checked by pid and start time."""
        st = self.state()
        return alive(st.get("%s_pid" % which), st.get("%s_start" % which, ""))

    def poke(self):
        self.brain.mkdir(parents=True, exist_ok=True)
        (self.brain / "poke").write_text(now())

    def log(self, msg):
        (self.brain / "logs").mkdir(parents=True, exist_ok=True)
        with open(self.brain / "logs" / "scheduler.log", "a") as f:
            f.write("%s %s\n" % (now(), msg))


def write_catalog(project):
    store = Path(project) / STORE
    if not store.is_dir():
        return
    lines = ["# .coordinator", "",
             "Coordinator's knowledge for this project. Generated by `coord`; don't edit by hand.", "",
             "| Go to | For |", "|---|---|",
             "| [config.json](config.json) | gate, setup, dev server and agent settings |"]
    if (store / "map" / "AGENTS.md").exists():
        lines.append("| [map/AGENTS.md](map/AGENTS.md) | the project map: read it before exploring the code |")
    for r in list_runs(project):
        d = r.load()
        first = (d.get("request") or "").strip().splitlines()[0][:90] if d.get("request") else ""
        target = "%s/plan.md" % r.name if (r.dir / "plan.md").exists() else "%s/tasks.json" % r.name
        lines.append("| [%s](%s) | %s run, %s: %s |" % (target, target, d.get("mode"),
                                                       d.get("status", "").replace("_", " "), first.replace("|", "/")))
    (store / "AGENTS.md").write_text("\n".join(lines) + "\n")


def list_runs(project):
    base = Path(project) / STORE
    if not base.is_dir():
        return []
    return [Run(project, p.name) for p in sorted(base.iterdir()) if (p / "tasks.json").exists()]


def pick_run(name=None):
    if os.environ.get("COORD_RUN_DIR") and not name:
        p = Path(os.environ["COORD_RUN_DIR"])
        return Run(p.parent.parent, p.name)
    project = project_root()
    if name:
        r = Run(project, name)
        r.load()
        return r
    runs = list_runs(project)
    if not runs:
        raise Fail("no coordinator in this project yet; start one with /coordinate <request>")
    live = [r for r in runs if r.load().get("status") not in ("finished", "planned")] or runs
    return max(live, key=lambda r: r.load().get("updated", ""))


def find(data, tid):
    for t in data["tasks"]:
        if t["id"] == tid:
            return t
    raise Fail("no task %s" % tid)


def new_task(tid, title, type_="build", deps=None, files=None, size="M", model="", effort=""):
    return {"id": tid, "title": title, "type": type_, "status": "queue", "depends_on": deps or [],
            "files": files or [], "size": size, "model": model, "effort": effort, "attempts": 0,
            "session": "", "question": "", "question_kind": "", "question_default": "", "question_at": "",
            "answer": "", "qa": [], "inbox": [],
            "resume": False, "resume_msg": "", "audit_round": 0, "audit_verdict": "", "audit_file": "",
            "tests": False, "ui": False, "merged": False, "merge_state": "", "started": "", "finished": "", "minutes": 0.0,
            "tokens": 0, "cost": 0.0, "intent": "", "rest": "", "pending_approval": False}


def officer_on_plan(cfg, data):
    mode = cfg["officer"].get("plan", "auto")
    if mode in (True, "always"):
        return True
    if mode in (False, "never", None, ""):
        return False
    return bool(data.get("full_auto")) or sum(1 for t in data["tasks"] if t["type"] == "build"
                                              and t["status"] != "skipped" and not t.get("parent")) > 3


def critical_path(data):
    """(tasks, longest chain of dependencies) over the run's own build tasks."""
    tasks = {t["id"]: t for t in data["tasks"] if t["type"] == "build" and t["status"] != "skipped" and not t.get("parent")}
    memo = {}

    def depth(tid, seen=()):
        if tid in memo:
            return memo[tid]
        if tid in seen or tid not in tasks:
            return 0
        memo[tid] = 1 + max([depth(d, seen + (tid,)) for d in tasks[tid]["depends_on"]] or [0])
        return memo[tid]

    return len(tasks), max([depth(t) for t in tasks] or [0])


def next_id(data, prefix="T"):
    nums = [int(m.group(1)) for t in data["tasks"] for m in [re.match(prefix + r"(\d+)$", t["id"])] if m]
    return "%s%d" % (prefix, max(nums) + 1 if nums else 1)


def deps_met(t, by):
    for d in t["depends_on"]:
        dep = by.get(d)
        if not dep or dep["status"] not in ("done", "skipped"):
            return False
        if dep["type"] in WORK and dep["status"] == "done" and not dep.get("merged"):
            return False
    return True


def _prefix(p):
    p = p.strip()
    p = p[2:] if p.startswith("./") else p
    m = re.search(r"[*?\[]", p)
    return p[:m.start()] if m else p


def overlap(a, b):
    fa, fb = a.get("files") or [], b.get("files") or []
    if not fa or not fb:
        return True
    for x in map(_prefix, fa):
        for y in map(_prefix, fb):
            if not x or not y or x.startswith(y) or y.startswith(x):
                return True
    return False


def derive_status(data, running=False):
    if data.get("status") == "paused":
        return "paused"
    tasks = data["tasks"]
    if any(t["status"] == "waiting_on_you" for t in tasks):
        return "waiting_on_you"
    plans_open = [t for t in tasks if t["type"] == "plan" and t["status"] in OPEN]
    if not data.get("plan_approved"):
        return "planning" if plans_open or running else "waiting_on_you"
    if plans_open or running:
        return "running"
    if data.get("mode") == "plan":
        return "planned"
    if any(t["status"] in OPEN for t in tasks if t["type"] != "plan" and not t.get("pending_approval")):
        return "running"
    if any(t["type"] in WORK and t["status"] == "done" and not t.get("merged") for t in tasks):
        return "running"
    if any(t.get("pending_approval") and t["status"] == "queue" for t in tasks):
        return "waiting_on_you"
    return "finished"


def pending_changes(data):
    return [t for t in data["tasks"] if t.get("pending_approval") and t["status"] == "queue"]


def summary(data, scheduler_alive=None):
    tasks = [t for t in data["tasks"] if t["type"] in WORK]
    done = sum(1 for t in tasks if t["status"] in ("done", "skipped"))
    active = [t["id"] for t in data["tasks"] if t["status"] in ("in_progress", "review", "audit")]
    waiting = [t["id"] for t in data["tasks"] if t["status"] == "waiting_on_you"]
    tok = sum(t.get("tokens", 0) for t in data["tasks"])
    cost = sum(t.get("cost", 0) for t in data["tasks"])
    mins = sum(t.get("minutes", 0) for t in data["tasks"])
    parts = ["%s: %s" % (data["name"], data["status"].replace("_", " "))]
    if data.get("quick"):
        parts.append("quick run")
    if data.get("full_auto"):
        parts.append("full auto")
    if tasks:
        parts.append("%d/%d tasks done" % (done, len(tasks)))
    if active:
        parts.append("working: " + ", ".join(active))
    if waiting:
        parts.append("waiting on you: " + ", ".join(waiting))
    if not data.get("plan_approved") and data["status"] == "waiting_on_you" and not waiting:
        parts.append("the plan waits for your approval")
    if data.get("plan_approved") and pending_changes(data):
        parts.append("plan changes wait for your approval")
    parts.append("$%.2f, %s agent time (%s tokens)" % (cost, human_minutes(mins), human_tokens(tok)))
    if scheduler_alive is False and data["status"] in ("running", "planning"):
        parts.append("scheduler is not running - use `coord resume`")
    return " · ".join(parts)


def question_deadline(r, data, t):
    """When an agent's question answers itself with its default, or None for a question that waits for the owner."""
    if t.get("status") != "waiting_on_you" or (t.get("question_kind") or "agent") != "agent" \
            or not t.get("question_default") or not t.get("question_at"):
        return None
    minutes = 3 if data.get("full_auto") else float(r.cfg.get("question_minutes") or 0)
    if minutes <= 0:
        return None
    return dt.datetime.fromisoformat(t["question_at"]) + dt.timedelta(minutes=minutes)


def owner_actions(r, data, scheduler_alive=None):
    """Everything waiting on the owner, in order. One list for the live page and the chat."""
    if scheduler_alive is None:
        scheduler_alive = r.alive("scheduler")
    out = []
    add = lambda key, kind, text, do, **kw: out.append(dict(key=key, kind=kind, text=text, do=do, **kw))
    asks = [t for t in data["tasks"] if t["status"] == "waiting_on_you"]
    if not data.get("plan_approved") and data["status"] == "waiting_on_you" and not asks:
        add("plan", "plan", "The plan is ready for your approval", "approve it (`coord approve`) or say what to change")
    changes = pending_changes(data)
    if data.get("plan_approved") and changes and not any(t["type"] == "plan" and t["status"] in OPEN for t in data["tasks"]):
        add("changes-" + ",".join(t["id"] for t in changes), "changes",
            "The planner added %s for your addition" % ", ".join("%s (%s)" % (t["id"], t["title"]) for t in changes),
            "approve them (`coord approve`) or say what to change (`coord add`)", tasks=[t["id"] for t in changes])
    for t in asks:
        qk = t.get("question_kind") or "agent"
        do = {"officer": "`coord accept %s`, or `coord answer %s \"<what to change>\"`" % (t["id"], t["id"]),
              "stalled": "`coord retry %s`, `coord stop %s`, or `coord answer %s \"<guidance>\"`" % ((t["id"],) * 3)}
        default_at = question_deadline(r, data, t)
        extra = dict(default=t.get("question_default") or "", default_at=default_at.isoformat(timespec="seconds")
                     if default_at else "")
        text = t.get("question") or ""
        if default_at:
            text += " (default if you don't answer by %s: %s)" % (default_at.strftime("%H:%M"), t["question_default"])
        add("q-" + t["id"], "question", text, do.get(qk, "`coord answer %s \"<answer>\"`" % t["id"]),
            task=t["id"], title=t["title"], question_kind=qk, **extra)
    if scheduler_alive is False and data["status"] in ("running", "planning"):
        add("scheduler", "scheduler", "The scheduler stopped while the run was %s" % data["status"], "`coord resume`")
    for f in data.get("followups") or []:
        repo = Path(f["repo"]).name
        if f.get("status") == "failed":
            add("fu-" + f["repo"], "followup", "The follow-up run in %s failed to start: %s" % (repo, f.get("error")),
                "start it yourself from that repo with /coordinate", repo=f["repo"], failed=True)
        elif f.get("status") == "started":
            fu = read_json(Path(f["repo"]) / STORE / f["run"] / "tasks.json")
            if fu and not fu.get("plan_approved"):
                add("fu-" + f["repo"], "followup", "Approve the plan of the follow-up run %s in %s" % (f["run"], repo),
                    f.get("url") or "`coord status %s` in that repo" % f["run"], repo=f["repo"], url=f.get("url") or "")
    for x in data.get("todos") or []:
        if not x.get("done"):
            add("todo-%d" % x["n"], "todo", x["text"], "when it's done: `coord todo done %d`" % x["n"], n=x["n"], task=x.get("task", ""))
    if data["status"] == "finished":
        if data.get("parent"):
            if data.get("pr_url") and not data.get("pr_merged"):
                top = first_run(data)
                add("pr", "pr", "Review and merge the pull request", "%s; to merge all, run `coord merge %s` in %s" % (
                    data["pr_url"], top["run"], top["repo"]), url=data["pr_url"], parent=data["parent"])
        else:
            prs = pull_requests(r, data)
            urls = [p["url"] for p in prs if p["url"]]
            if urls and not all(p["merged"] for p in prs):
                ready, waiting_for = merge_ready(r, data, prs)
                merge = data.get("merge") or {}
                text = "Review and merge the pull request" + ("s" if len(prs) > 1 else "")
                do = ", ".join(urls)
                if ready:
                    text = "Merge all %d pull requests and end the session?" % len(prs) if len(prs) > 1 else \
                        "Merge the pull request and end the session?"
                    do = "`coord merge` (merges them in order, then ends every run), or merge them yourself"
                    if merge.get("status") == "failed":
                        do += " (the last merge failed: %s)" % merge.get("error")
                add("pr", "pr", text, do, url=data.get("pr_url") or urls[0], prs=prs, ready=ready,
                    waiting_for=waiting_for, merge=merge)
        external = sorted({f for t in data["tasks"] if t.get("status") == "done" for f in (t.get("external") or [])})
        if external:
            add("external", "external", "Commit the files updated outside the repo (coord doesn't commit them)",
                ", ".join(external), files=external)
    return out


def pull_requests(r, data):
    """The run's pull request, then its follow-up runs', depth first. Read from disk only, never from GitHub."""
    out, seen = [], set()

    def walk(repo, name, d, own):
        key = (str(Path(repo).resolve()), name)
        if key in seen:
            return
        seen.add(key)
        out.append(dict(repo=key[0], repo_name=Path(repo).name, run=name, url=d.get("pr_url") or "",
                        status=d.get("status") or "", merged=bool(d.get("pr_merged")), self=own))
        for f in d.get("followups") or []:
            if f.get("status") == "started" and f.get("run"):
                fu = read_json(Path(f["repo"]) / STORE / f["run"] / "tasks.json")
                if fu:
                    walk(f["repo"], f["run"], fu, False)

    walk(r.project, r.name, data, True)
    return out


def first_run(data):
    """The {repo, run} at the top of a follow-up run's parent links."""
    top, p, seen = None, data.get("parent"), set()
    while p and (p["repo"], p["run"]) not in seen:
        seen.add((p["repo"], p["run"]))
        top = p
        p = (read_json(Path(p["repo"]) / STORE / p["run"] / "tasks.json") or {}).get("parent")
    return top


def merge_ready(r, data, prs=None):
    """(ready, waiting_for) for "merge all": a first run, every family run finished with a pull request, no merge running."""
    prs = prs if prs is not None else pull_requests(r, data)
    waiting_for = [p["run"] for p in prs if p["status"] != "finished" or not p["url"]]
    merge = data.get("merge") or {}
    busy = merge.get("status") == "merging" and alive(merge.get("pid"))
    return not data.get("parent") and not waiting_for and not busy, waiting_for


def other_repo_env():
    # For coord started in another repo: none of this run's agent variables
    return {k: v for k, v in os.environ.items() if k not in ("COORD_PROJECT", "COORD_RUN_DIR", "COORD_TASK", "COORD_ROLE")}


# ---------------------------------------------------------------- agents

def role_of(t):
    return {"plan": "planner", "shots": "shooter", "map": "mapper", "pr": "writer"}.get(t["type"], "builder")


def role_prompt(role):
    # Every role works as a senior engineer and keeps comments to what one would write
    return (ROOT / "roles" / ("%s.md" % role)).read_text() + (ROOT / "roles" / "senior.md").read_text()


def session_exists(sid):
    return bool(sid) and any((Path.home() / ".claude" / "projects").glob("*/%s.jsonl" % sid))


def role_prompt_file(r, role):
    """The role's prompt as a file for --append-system-prompt-file: an argument with newlines doesn't survive cmd.exe."""
    d = r.brain / "roles"
    d.mkdir(parents=True, exist_ok=True)
    f = d / ("%s.md" % role)
    text = role_prompt(role)
    if not f.exists() or f.read_text() != text:
        f.write_text(text)
    return f


def agents_json(r):
    return json.dumps(read_json(r.brain / "agents.json", {}), ensure_ascii=False, separators=(",", ":"))


def write_agent_files(r):
    r.brain.mkdir(parents=True, exist_ok=True)
    agents = {"coord-reviewer": {
        "description": "Fresh code reviewer for one coordinator task: reads the task's knowledge file, "
                       "its changes.md and the diff, then writes review.md.",
        "prompt": role_prompt("reviewer"),
        "model": r.cfg["models"]["reviewer"],
        "effort": r.cfg["efforts"]["reviewer"]},
        "coord-briefer": {
        "description": "Reads big content (long files, logs, script outputs, scraped data) on a smaller model and "
                       "writes a short brief for the agent that called it.",
        "prompt": role_prompt("briefer"),
        "model": r.cfg["models"]["briefer"],
        "effort": r.cfg["efforts"]["briefer"],
        "tools": ["Read", "Grep", "Glob", "Bash", "Write"]}}
    write_json(r.brain / "agents.json", agents)
    hook = " ".join('"%s"' % c.replace("\\", "/") for c in coord_argv()) + " _hook"
    # On Windows agents get Bash (Git Bash) only, so the Bash deny rules and hook checks cover every shell command
    deny = list(r.cfg["deny"]) + (["PowerShell"] if WINDOWS else [])
    settings = {"permissions": {"allow": ["Bash(coord:*)"], "deny": deny},
                "hooks": {"PreToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": hook}]}]}}
    write_json(r.brain / "settings.json", settings)


def agent_env(r, tid, role, cwd, data=None):
    env = dict(os.environ)
    env.update(COORD_PROJECT=str(r.project), COORD_RUN_DIR=str(r.dir), COORD_TASK=tid, COORD_ROLE=role, COORD_ROOT=str(ROOT),
               CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD="1",
               COORD_WT=str(cwd), PATH="%s%s%s" % (shim_dir() if WINDOWS else ROOT / "bin", os.pathsep, env.get("PATH", "")))
    if data:
        env.update(COORD_RUN_BRANCH=data.get("branch") or "", COORD_BASE=data.get("base") or "")
    return env


def write_shims(bin_dir):
    """`coord` for Git Bash and `coord.cmd` for cmd and PowerShell, both running this checkout with this Python."""
    py, script = sys.executable, str(ROOT / "bin" / "coord")
    shims = {"coord": '#!/bin/sh\nexec "%s" -X utf8 "%s" "$@"\n' % (py.replace("\\", "/"), script.replace("\\", "/")),
             "coord.cmd": '@"%s" -X utf8 "%s" %%*\r\n' % (py, script)}
    bin_dir.mkdir(parents=True, exist_ok=True)
    for name, text in shims.items():
        f = bin_dir / name
        if not f.exists() or f.read_text() != text:
            with open(f, "w", newline="") as out:
                out.write(text)


def shim_dir():
    d = HOME / "bin"
    write_shims(d)
    return d


def ensure_branch(r, data):
    if not git(r.project, "branch", "--list", data["branch"]):
        git(r.project, "branch", data["branch"], data["base"])


def setup_worktree(r, wt):
    if not r.cfg.get("setup"):
        return
    (r.brain / "logs").mkdir(parents=True, exist_ok=True)
    env = dict(os.environ, COORD_MAIN=str(r.project), COORD_WT=str(wt))
    args, shell = sh(r.cfg["setup"])
    res = subprocess.run(args, shell=shell, cwd=str(wt), env=env, capture_output=True, text=True)
    (r.brain / "logs" / ("setup-%s.log" % wt.name)).write_text(res.stdout + res.stderr)


def ensure_run_wt(r, data):
    ensure_branch(r, data)
    wt = r.wt("_run")
    if not wt.exists():
        wt.parent.mkdir(parents=True, exist_ok=True)
        git(r.project, "worktree", "add", str(wt), data["branch"])
        ignore_store(r, wt)
        setup_worktree(r, wt)
    return wt


def ignore_store(r, wt):
    # On the run branch, so the line reaches the base branch through the run's PR and the owner's checkout stays clean
    if not r.cfg.get("gitignore", True):
        return
    gi = wt / ".gitignore"
    text = gi.read_text() if gi.exists() else ""
    if any(line.strip() in ("/.coordinator/", ".coordinator/", "/.coordinator", ".coordinator") for line in text.splitlines()):
        return
    sep = "" if not text else ("\n" if text.endswith("\n") else "\n\n")
    gi.write_text(text + sep + "# Coordinator's local knowledge\n/%s/\n" % STORE)
    commit_all(wt, "Ignore Coordinator's local folder.", paths=(".gitignore",))


GIT_LOCK = threading.RLock()  # the scheduler's merges run on their own thread; git refs don't take two writers well


def prepare_worktree(r, data, t):
    with GIT_LOCK:
        ensure_run_wt(r, data)
        wt, br = r.wt(t["id"]), r.task_branch(t["id"])
        if wt.exists():
            return wt
        if git(r.project, "branch", "--list", br):
            git(r.project, "worktree", "add", str(wt), br)
        else:
            git(r.project, "worktree", "add", "-b", br, str(wt), data["branch"])
    setup_worktree(r, wt)
    patch = r.task_dir(t["id"]) / "wip.patch"
    if nonempty(patch):
        res = run(["git", "apply", "--3way", "--whitespace=nowarn", patch], cwd=wt, check=False)
        r.log("%s: applied saved work (%s)" % (t["id"], "ok" if res.returncode == 0 else res.stderr.strip()[-200:]))
        if res.returncode == 0:
            patch.rename(patch.with_suffix(".patch.applied"))
        else:
            with r.edit() as d:
                find(d, t["id"])["resume_msg"] = (
                    "Saved work from an earlier session did not apply cleanly; it is in %s. Apply what still fits by "
                    "hand, then continue." % patch)
    return wt


def same_instructions(a, b):
    names = [n for n in INSTRUCTION_NAMES if (Path(a) / n).is_file() or (Path(b) / n).is_file()]
    for n in names:
        try:
            if (Path(a) / n).read_bytes() != (Path(b) / n).read_bytes():
                return False
        except OSError:
            return False
    return True


def add_dirs(r, cwd):
    _, dirs = project_instructions(r.project)
    skip = {Path(cwd).resolve(), Path.home().resolve()}  # the user's own CLAUDE.md loads in every session anyway
    own = Path(cwd).resolve() != r.project
    if own and same_instructions(cwd, r.project):
        skip.add(r.project)  # a worktree loads its own committed copies; the same files twice only cost tokens
    extra = [str(d) for d in dirs if Path(d).resolve() not in skip]
    if own and not any(under(str(r.dir.resolve()), d) for d in extra):
        extra.append(str(r.dir))  # the task's own folder: its brief, changes.md, review.md
    return ["--add-dir"] + extra if extra else []


def first_prompt(r, data, t, role, cwd):
    kd = r.task_dir(t["id"])
    lines = ["You are the %s for task %s (%s) in the coordinator run '%s'." % (ROLE_NAMES[role], t["id"], t["title"], r.name),
             "Coordinator's folder (bundled guides and roles): %s" % ROOT,
             "Run folder: %s" % r.dir] + instructions_block(r, role) + [
             "Your knowledge file: %s - read it next, in full." % (kd / "knowledge.md")]
    if role == "planner":
        if data.get("owner_notes"):
            lines += ["The owner has added to the request since:", owner_words(data).split("\n", 1)[1]]
        lines += ["Project: %s (base branch %s). Project config: %s" % (r.project, data["base"], r.project / STORE / "config.json"),
                  "Write the plan to: %s" % (r.dir / "plan.md"),
                  "Mode: %s" % ("plan only - milestones and tasks for later runs; nothing gets built now"
                                if data["mode"] == "plan" else "build - the tasks are built right after the owner approves")]
    elif role == "builder":
        check = r.cfg.get("check") or "none configured - run the fast checks for what you touched (typecheck or " \
                                      "lint of that package, the tests next to the files you changed), not a full build"
        gate = r.cfg.get("gate")
        lines += ["Your worktree (work only here): %s, on branch %s, made from the run branch %s." % (cwd, r.task_branch(t["id"]), data["branch"]),
                  "Write your changes file to: %s" % (kd / "changes.md"),
                  "Your reviewer writes to: %s" % (kd / "review.md"),
                  "Check (fast, run it from %s in your worktree before you finish): %s" % (r.cfg.get("gate_cwd", "."), check),
                  ("The full gate (%s) runs once, by the scheduler, after your work merges; don't run it yourself unless "
                   "your brief says so." % gate) if gate else "No full gate is configured; your check is the proof.",
                  "Files outside your worktree you may edit in place (the scheduler doesn't commit them): %s"
                  % (", ".join(t.get("external") or []) or "none"),
                  "Design language for this UI task: %s" % (design_line(data) if t.get("ui") else "not a UI task"),
                  "Tests for this task: %s" % (
                      "ON - the owner asked for tests; write only the few the knowledge file names, short and to the point."
                      if t.get("tests") else
                      "OFF - don't add or delete test files or add test cases. If your change breaks an existing test "
                      "only through a type, name or signature it uses, make that small edit (up to a few lines per file) "
                      "and list it under \"Forced test edits\" in changes.md. Anything bigger: ask with `coord task ask`.")]
        if data.get("quick"):
            lines += ["This is a quick run: there is no planner and no plan. Your brief is the owner's request. Follow "
                      "\"Quick runs\" in your role.",
                      "Write the pull request description to: %s" % (r.dir / "pr.md")]
        if t.get("ui") and r.cfg["dev"].get("command"):
            lines.append("Screenshots: `coord _shoot --page \"<path>\"` shoots your worktree against the base branch "
                         "and saves the PNGs in your task folder.")
    elif role == "shooter":
        lines += ["Plan: %s" % (r.dir / "plan.md")]
    elif role == "writer":
        lines += ["Plan: %s" % (r.dir / "plan.md"),
                  "The change: run `git diff %s...%s` in %s." % (data["base"], data["branch"], r.project),
                  "Write the description to: %s" % (r.dir / "pr.md")]
    elif role == "mapper":
        lines += ["Project: %s. The map goes in %s." % (r.project, r.project / STORE / "map"),
                  "A map already exists there; refresh it." if (r.project / STORE / "map" / "AGENTS.md").exists()
                  else "There is no map yet; build it."]
    if nonempty(kd / "resume.md"):
        lines.append("Resume note from an earlier session: %s - read it after the knowledge file." % (kd / "resume.md"))
    if (kd / "wip.patch.applied").exists():
        lines.append("Work saved by an earlier session was applied to your worktree; check `git status` first.")
    if t.get("qa"):
        lines.append("Earlier questions and the owner's answers:")
        lines += ["- Q: %s\n  A: %s" % (x["q"], x["a"]) for x in t["qa"]]
    if t.get("resume_msg"):
        lines.append(t["resume_msg"])
    lines.append("`coord task show` prints your task. Follow your role instructions exactly.")
    return "\n".join(lines)


def design_line(data):
    d = data.get("design") or {}
    if not d.get("choice"):
        return "not chosen"
    return "%s%s" % (d["choice"], (" - " + d["source"]) if d.get("source") else "")


def audit_prompt(r, data, t):
    rnd = t["audit_round"]
    tests_line = []
    if t["type"] == "map":
        report = r.dir / ("map-audit-%d.md" % rnd)
        what = ["Audit the PROJECT MAP (round %d), following the 'Map audit' section of your role." % rnd,
                "The map: %s (start at AGENTS.md). The project: %s." % (r.project / STORE / "map", r.project)]
    elif t["type"] == "plan":
        report = r.dir / ("plan-audit-%d.md" % rnd)
        what = ["Audit the PLAN (round %d)." % rnd,
                "Plan: %s" % (r.dir / "plan.md"),
                "Tasks: run `coord task list`. Each task's brief: %s/<id>/knowledge.md" % (r.dir / "tasks"),
                "Design language recorded for the UI tasks: %s" % design_line(data)]
    else:
        report = r.task_dir(t["id"]) / ("audit-%d.md" % rnd)
        what = ["Audit the FINISHED TASK %s (%s), round %d." % (t["id"], t["title"], rnd),
                "Plan: %s" % (r.dir / "plan.md"),
                "The task's brief: %s" % (r.task_dir(t["id"]) / "knowledge.md"),
                "What the builder says it changed: %s" % (r.task_dir(t["id"]) / "changes.md"),
                "The change itself: run `git -C \"%s\" diff --stat %s`, then read the diff (`git -C \"%s\" diff %s`) "
                "in chunks." % (r.wt(t["id"]), data["branch"], r.wt(t["id"]), data["branch"])]
        if r.wt(t["id"]).exists():
            tests = [f for f in changed_files(r.wt(t["id"]), data["branch"]) if is_test_file(r.cfg, f)]
            tests_line = ["Test files this change adds or modifies: %s. Tests for this task are %s."
                          % (", ".join(tests) or "none", "ON (the planner says the owner asked)" if t.get("tests") else "OFF")]
    if rnd > 1:
        what.append("Your earlier reports are next to this one; check that what they asked for was done.")
    what += instructions_block(r, "officer")
    return "\n".join(["You are the hallucination officer of the coordinator run '%s'." % r.name,
                      "Everything the owner has asked for, word for word (the request, then later additions and answers):",
                      "<<<", owner_words(data), ">>>"] + what + tests_line +
                     ["Write your report to: %s" % report,
                      "Then run `coord audit approve --file \"%s\"`, `coord audit notes --file \"%s\"` (approve, with "
                      "should-fix notes for the owner) or `coord audit revise --file \"%s\"`, and end your turn."
                      % (report, report, report)])


class Job:
    """One agent process: started here, or adopted from an earlier scheduler of this run."""

    def __init__(self, kind, tid, role, proc, out_path, err_file, pid=None, start="", t0=None, session=""):
        self.kind, self.tid, self.role, self.p = kind, tid, role, proc
        self.out_path, self.err = out_path, err_file
        self.pid = proc.pid if proc else pid
        self.start = start or proc_start(self.pid)
        self.t0 = t0 or time.time()
        self.session = session
        self.stalled = False
        self.returncode = None

    def poll(self):
        if self.p is not None:
            self.returncode = self.p.poll()
            return self.returncode
        return None if alive(self.pid, self.start) else -1

    def record(self):
        return {"pid": self.pid, "start": self.start, "task": self.tid, "role": self.role, "kind": self.kind,
                "out": str(self.out_path), "t0": self.t0, "session": self.session,
                "since": dt.datetime.fromtimestamp(self.t0).astimezone().isoformat(timespec="seconds")}


def adopt_jobs(r):
    """The agents an earlier scheduler of this run left running, so a restart neither loses nor duplicates them."""
    jobs = {}
    for key, a in (r.state().get("agents") or {}).items():
        if a.get("pid") and a.get("out") and alive(a["pid"], a.get("start", "")):
            jobs[key] = Job(a["kind"], a["task"], a["role"], None, Path(a["out"]), None, pid=a["pid"],
                            start=a.get("start", ""), t0=a.get("t0"), session=a.get("session", ""))
    return jobs


def claude_argv(cfg):
    """The claude CLI to start. An npm `claude.cmd` would run through cmd.exe, which mangles JSON and newlines in
    arguments, so its node script is started directly."""
    exe = cfg["claude"]
    if isinstance(exe, list):  # a command line, for a wrapper or a stand-in
        return [str(x) for x in exe]
    if WINDOWS:
        found = shutil.which(exe)
        if found and found.lower().endswith((".cmd", ".bat")):
            cli = Path(found).parent / "node_modules" / "@anthropic-ai" / "claude-code" / "cli.js"
            node = shutil.which("node")
            if cli.is_file() and node:
                return [node, str(cli)]
        return [found or exe]
    return [exe]


def claude_found(cfg):
    exe = claude_argv(cfg)[0]
    return bool(shutil.which(exe) or Path(exe).is_file())


def agent_cmd(r, role, cwd, model, effort, name, sid, resume):
    cfg = r.cfg
    cmd = claude_argv(cfg) + ["-p"] + add_dirs(r, cwd) + [
        "--model", model, "--effort", effort, "--permission-mode", cfg["permission_mode"],
        "--settings", str(r.brain / "settings.json"), "--output-format", "json", "-n", name,
        "--append-system-prompt-file", str(role_prompt_file(r, role))]
    if role != "shooter":
        cmd += ["--agents", agents_json(r)]
    return cmd + (["--resume", sid] if resume else ["--session-id", sid])


def start_job(r, kind, tid):
    data = r.load()
    t = find(data, tid)
    cfg = r.cfg
    logs = r.brain / "logs"
    logs.mkdir(parents=True, exist_ok=True)
    n = len(list(logs.glob("%s-*.json" % tid))) + 1
    if kind == "audit":
        role = "officer"
        sid = str(uuid.uuid4())
        with r.edit() as d:
            tt = find(d, tid)
            tt["audit_round"] += 1
            tt["audit_verdict"] = ""
            tt.setdefault("audit_sessions", []).append({"round": tt["audit_round"], "session": sid})
            t = dict(tt)
        cwd, resume = r.project, False
        model = cfg["models"]["officer"]
        effort = cfg["efforts"]["officer"] if t["type"] == "plan" else cfg["efforts"].get("officer_task", "medium")
        name = "%s:%s:officer" % (r.name, tid)
        prompt = audit_prompt(r, data, t)
    else:
        role = role_of(t)
        cwd = prepare_worktree(r, data, t) if role == "builder" else r.project
        with r.edit() as d:
            tt = find(d, tid)
            answer = tt.get("answer", "")
            if answer:
                tt["qa"].append({"q": tt.get("question", ""), "a": answer,
                                 "by_default": bool(tt.get("answered_by_default"))})
            resume = bool(tt.get("resume") and session_exists(tt.get("session")))
            sid = tt["session"] if resume else str(uuid.uuid4())
            if resume and answer and tt.get("answered_by_default"):
                prompt = ("The owner didn't answer within the deadline, so your default stands: %s. Act on it, note "
                          "it in changes.md, and carry on." % answer)
            elif resume and answer:
                prompt = "The owner answered your question: %s" % answer
            elif resume:
                prompt = tt.get("resume_msg") or "Continue from where you stopped, then finish the task."
            else:
                prompt = first_prompt(r, d, tt, role, cwd)
            tt.update(status="in_progress", session=sid, resume=False, resume_msg="", answer="", question="",
                      question_kind="", question_default="", question_at="", answered_by_default=False,
                      started=tt["started"] or now())
            t = dict(tt)
        model = t.get("model") or cfg["models"][role]
        effort = t.get("effort") or cfg["efforts"][role]
        name = "%s:%s" % (r.name, tid)
    cmd = agent_cmd(r, role, cwd, model, effort, name, sid, resume)
    prompt_file = logs / ("%s-%d.prompt" % (tid, n))
    prompt_file.write_text(prompt)
    out_path = logs / ("%s-%d.json" % (tid, n))
    out = open(out_path, "w")
    err = open(logs / ("%s-%d.err" % (tid, n)), "w")
    stdin = open(prompt_file)  # the prompt on stdin: no command-line length limit, no quoting through a shell
    proc = spawn(cmd, cwd=str(cwd), env=agent_env(r, tid, role, cwd, data), stdout=out, stderr=err, stdin=stdin)
    out.close()
    stdin.close()
    r.log("started %s %s (%s, pid %d, %s/%s)" % (role, tid, kind, proc.pid, model, effort))
    return Job(kind, tid, role, proc, out_path, err, session=sid)


def usage_of(out):
    if not out:
        return 0, 0.0
    mu = out.get("modelUsage") or {}
    if mu:
        tok = sum(m.get("inputTokens", 0) + m.get("outputTokens", 0) + m.get("cacheReadInputTokens", 0)
                  + m.get("cacheCreationInputTokens", 0) for m in mu.values())
    else:
        u = out.get("usage") or {}
        tok = sum(u.get(k) or 0 for k in ("input_tokens", "output_tokens", "cache_read_input_tokens",
                                           "cache_creation_input_tokens"))
    return tok, float(out.get("total_cost_usd") or 0.0)


def finish_job(r, job):
    if job.err:
        job.err.close()
    out = None
    if job.out_path.exists() and job.out_path.stat().st_size:
        out = read_json(job.out_path, None)
    tok, cost = usage_of(out)
    plan_rounds = int(r.cfg["officer"].get("max_rounds", 1))
    task_rounds = int(r.cfg["officer"].get("task_rounds", 2))
    with r.edit() as d:
        t = find(d, job.tid)
        t["minutes"] = round(t.get("minutes", 0) + (time.time() - job.t0) / 60, 1)
        t["tokens"] = t.get("tokens", 0) + tok
        t["cost"] = round(t.get("cost", 0) + cost, 4)
        if job.kind == "audit":
            rounds = plan_rounds if t["type"] in ("plan", "map") else task_rounds
            if t["status"] != "audit":
                pass
            elif t["audit_verdict"] in ("approve", "notes"):
                t["status"] = "done"
            elif t["audit_verdict"] == "revise":
                if t["type"] in ("plan", "map") and t["audit_round"] >= rounds:
                    # The last round: the planner fixes what it can once more, and the owner sees the report
                    t["audit_final"] = True
                    t["status"] = "queue"
                    t["resume"] = True
                    t["resume_msg"] = ("The hallucination officer asks for changes: read its report at %s. Fix every "
                                       "must-fix item that is right, say in one line under \"Approach\" in plan.md why "
                                       "you left any, then run `coord task done`. The owner sees the report with the "
                                       "plan; there is no further audit." % t["audit_file"])
                elif t["audit_round"] >= rounds:
                    t["status"] = "waiting_on_you"
                    t["question_kind"] = "officer"
                    t["question"] = ("The hallucination officer still asks for changes after %d rounds (last report: %s). "
                                     "Accept it as it is, or reply with what to change." % (t["audit_round"], t["audit_file"]))
                else:
                    t["status"] = "queue"
                    t["resume"] = True
                    t["resume_msg"] = ("The hallucination officer checked your work and asks for changes. Read its report "
                                       "at %s, fix what it asks (or explain in your files why not), then run "
                                       "`coord task done` again." % t["audit_file"])
            else:
                t["audit_round"] -= 1
                t["audit_fail"] = t.get("audit_fail", 0) + 1
                if t["audit_fail"] >= 2:
                    t["status"] = "done" if t["type"] in ("plan", "map") else "waiting_on_you"
                    if t["status"] == "waiting_on_you":
                        t["question_kind"] = "officer"
                        t["question"] = "The officer could not finish its check. Accept the work as it is, or reply with what to do."
        elif t["status"] in ("in_progress", "review"):
            t["attempts"] += 1
            last = (out or {}).get("result") or "(no result; exit %s)" % job.returncode
            if t["attempts"] < 2:
                t["status"] = "queue"
                t["resume"] = True
                t["resume_msg"] = ("Your session was stopped after %d minutes without progress. Check where you are, "
                                   "then finish the task; run long commands in the background with their output in a "
                                   "log file." % int(r.cfg.get("stall_minutes") or 30)) if job.stalled else \
                    "Your session ended before the task was done. Check where you are, then finish the task."
            elif t["type"] == "pr":  # the pull request keeps its short description; the run still finishes
                t["status"] = "skipped"
            else:
                t["status"] = "waiting_on_you"
                t["question_kind"] = "stalled"
                t["question"] = "%s stopped twice without finishing. Its last words: %s - retry it, stop it, or reply with guidance." % (job.tid, str(last)[:400])
    r.log("finished %s %s (exit %s, %s tokens, $%.2f)" % (job.role, job.tid, job.returncode, tok, cost))


def git_ident(wt):
    return [] if git(wt, "config", "user.email", check=False) else ["-c", "user.name=coordinator", "-c", "user.email=coordinator@localhost"]


def commit_all(wt, msg, paths=("-A",)):
    git(wt, "add", *paths)
    merging = (Path(git(wt, "rev-parse", "--absolute-git-dir")) / "MERGE_HEAD").exists()
    if not git(wt, "status", "--porcelain") and not merging:
        return False
    run(["git", *git_ident(wt), "commit", "--no-verify", "-m", msg], cwd=wt)
    return True


def add_fix(r, parent, kind, detail):
    """A task that repairs a merge (kind merge), the gate after a merge (gate), or the base branch coming in (base)."""
    with r.edit() as d:
        p = find(d, parent) if parent else None
        if p:
            p["merge_state"] = "gate-red" if kind == "gate" else "fixing"
        stem = parent or "B"
        fid, n = "%s-%s" % (stem, kind), 2
        while any(t["id"] == fid for t in d["tasks"]):
            fid, n = "%s-%s%d" % (stem, kind, n), n + 1
        title = {"merge": "Resolve the merge of %s into the run branch" % parent,
                 "gate": "Fix the gate after merging %s" % parent,
                 "base": "Bring the base branch's new commits into the run branch"}[kind]
        t = new_task(fid, title, "merge" if kind in ("merge", "base") else "build", files=p["files"] if p else [],
                     size="S", model=p.get("model", "") if p else "", effort=p.get("effort", "") if p else "")
        t["parent"], t["fix_kind"] = parent, kind
        d["tasks"].append(t)
        branch, base = d["branch"], d["base"]
    kd = r.task_dir(fid)
    kd.mkdir(parents=True, exist_ok=True)
    pk = r.task_dir(parent) if parent else None
    if kind == "merge":
        body = ("Task %s could not be merged into the run branch `%s` automatically.\n\n"
                "In your worktree (a branch made from the run branch) run `git merge --no-commit %s`, resolve every "
                "conflict keeping the intent of both sides, then run the check. Don't commit: the scheduler does.\n\n"
                "The parent task's brief: %s\nIts changes: %s\n\n%s\n"
                % (parent, branch, r.task_branch(parent), pk / "knowledge.md", pk / "changes.md", detail))
    elif kind == "base":
        body = ("The base branch moved while this run worked, and `%s` no longer merges cleanly into the run branch "
                "`%s`.\n\nIn your worktree (a branch made from the run branch) run `git merge --no-commit %s`, "
                "resolve every conflict keeping the intent of both sides, then run the check. Don't commit: the "
                "scheduler does.\n\n%s\n" % (detail[0], branch, detail[0], detail[1]))
    else:
        body = ("After task %s was merged into the run branch `%s`, the gate fails. Your worktree is made from the "
                "run branch, so it already holds %s's changes. Make the gate pass with the smallest correct fix.\n\n"
                "If the failing checks have nothing to do with this run's changes (`git diff %s --stat` shows what "
                "the run changed), change no code: write in changes.md what fails and why it isn't this run's, and "
                "run `coord task done`. The scheduler then records it for the owner and carries on.\n\n"
                "The parent task's brief: %s\nIts changes: %s\n\nGate output, the error lines:\n\n```\n%s\n```\n"
                % (parent, branch, parent, base, pk / "knowledge.md", pk / "changes.md", detail))
    (kd / "knowledge.md").write_text("# %s - %s\n\n%s" % (fid, title, body))
    r.log("added %s" % fid)
    return fid


def run_gate(r, runwt, logf):
    cwd = runwt / r.cfg.get("gate_cwd", ".")
    t0 = time.time()
    with open(logf, "w") as f:
        if r.cfg.get("pre_gate"):
            args, shell = sh(r.cfg["pre_gate"])
            subprocess.run(args, shell=shell, cwd=str(cwd), stdout=f, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
            f.write("\n")
            f.flush()
        args, shell = sh(r.cfg["gate"])
        ok = subprocess.run(args, shell=shell, cwd=str(cwd), stdout=f, stderr=subprocess.STDOUT,
                            stdin=subprocess.DEVNULL).returncode == 0
    return ok, time.time() - t0


def sync_base(r, data, runwt):
    """Merge the base branch's new commits into the run branch after a task lands, so conflicts show up early and
    small. Returns (target, output) when it conflicts; the merge is then undone."""
    if not r.cfg.get("sync_base", True) or any(t.get("fix_kind") == "base" and t["status"] not in ("done", "skipped")
                                                for t in data["tasks"]):
        return None
    target = data["base"]
    if r.cfg.get("push") and run(["git", "remote", "get-url", "origin"], cwd=r.project, check=False).returncode == 0 \
            and run(["git", "fetch", "origin", data["base"]], cwd=r.project, check=False).returncode == 0:
        target = "origin/%s" % data["base"]
    if run(["git", "merge-base", "--is-ancestor", target, "HEAD"], cwd=runwt, check=False).returncode == 0:
        return None
    res = run(["git", *git_ident(runwt), "merge", "--no-edit", "--no-verify", target], cwd=runwt, check=False)
    if res.returncode:
        run(["git", "merge", "--abort"], cwd=runwt, check=False)
        return target, (res.stdout + res.stderr).strip()[-1500:]
    r.log("merged %s into the run branch" % target)
    return None


def integrate(r, tid):
    data = r.load()
    t = find(data, tid)
    wt = r.wt(tid)
    kind = t.get("fix_kind", "")
    with GIT_LOCK:
        runwt = ensure_run_wt(r, data)
        if wt.exists():
            commit_all(wt, t["title"])
        if kind == "base":
            res = run(["git", *git_ident(runwt), "merge", "--no-ff", "--no-edit", "--no-verify", r.task_branch(tid)],
                      cwd=runwt, check=False)
        else:
            res = run(["git", "merge", "--squash", r.task_branch(tid)], cwd=runwt, check=False)
        if res.returncode:
            run(["git", "merge", "--abort"], cwd=runwt, check=False)
            run(["git", "reset", "--hard", "HEAD"], cwd=runwt, check=False)
            if t.get("parent") and kind == "merge":
                with r.edit() as d:
                    find(d, tid).update(status="waiting_on_you", question_kind="stalled",
                                        question="The merge fix %s still doesn't merge into the run branch: %s"
                                                 % (tid, (res.stdout + res.stderr).strip()[-300:]))
                return
            add_fix(r, tid, "merge", (res.stdout + res.stderr).strip()[-1500:])
            return
        empty = kind != "base" and run(["git", "diff", "--cached", "--quiet"], cwd=runwt, check=False).returncode == 0
        if kind != "base":
            commit_all(runwt, t["title"])
        conflict = sync_base(r, data, runwt)
    if conflict:
        add_fix(r, "", "base", conflict)
    ok, known, flaky, secs, sig, logf, text = True, False, False, 0.0, set(), None, ""
    if r.cfg.get("gate"):
        logf = r.brain / "logs" / ("gate-%s.log" % tid)
        ok, secs = run_gate(r, runwt, logf)
        for _ in range(int(r.cfg.get("gate_retries", 1)) if not ok else 0):
            ok, more = run_gate(r, runwt, logf)
            secs += more
            flaky = ok
            if ok:
                r.log("gate flaky after %s: it failed, then passed on the re-run" % tid)
        if not ok:
            text = logf.read_text(errors="replace")
            sig = gate_signature(text)
            if data.get("gate_known") and sig and sig <= set(data["gate_known"]):
                ok = known = True
                r.log("gate after %s fails only with the failure already recorded for the owner" % tid)
            elif t.get("gate_override"):
                ok = True
                r.log("gate after %s fails; the owner accepted it" % tid)
    parent = find(data, t["parent"]) if t.get("parent") else None
    outside = False
    if not ok:
        excerpt = gate_excerpt(text) + "\n\nFull log: %s" % logf
        if parent and parent.get("merge_state") == "gate-red":
            if empty:
                outside = True  # the fixer found nothing of this run's to fix
            else:
                with r.edit() as d:
                    d.setdefault("gates", []).append(dict(task=tid, seconds=round(secs), ok=False, flaky=False, known=False))
                    find(d, tid).update(status="waiting_on_you", question_kind="gate",
                                        question="The gate still fails after %s's fix (log: %s). Retry it, accept it "
                                                 "(it merges with the gate red), or reply with guidance." % (t["parent"], logf))
                return
        else:
            with r.edit() as d:
                d.setdefault("gates", []).append(dict(task=tid, seconds=round(secs), ok=False, flaky=False, known=False))
            add_fix(r, tid, "gate", excerpt)
            return
    fid, rest = "", ""
    with r.edit() as d:
        d.setdefault("gates", []).append(dict(task=tid, seconds=round(secs), ok=ok and not outside, flaky=flaky,
                                              known=known or outside))
        if outside:
            d["gate_known"] = sorted(set(d.get("gate_known") or []) | sig)
            todos = d.setdefault("todos", [])
            todos.append({"n": max([x["n"] for x in todos] or [0]) + 1, "task": tid, "at": now(), "done": False,
                          "text": "The gate fails for reasons this run didn't cause (see %s and %s); the run carried on "
                                  "with it red." % (logf, r.task_dir(tid) / "changes.md")})
        tt = find(d, tid)
        tt["merged"], tt["merge_state"] = True, ""
        cur, seen = tt, set()
        while cur.get("parent") and cur["parent"] not in seen:
            seen.add(cur["parent"])
            cur = find(d, cur["parent"])
            cur["merged"], cur["merge_state"] = True, ""
        rest = (tt.get("rest") or "").strip() if tt["type"] == "build" else ""
        if rest:
            fid = next_id(d)
            nt = new_task(fid, "Finish: %s" % tt["title"], "build", [tid], tt["files"], tt["size"], tt.get("model", ""),
                          tt.get("effort", ""))
            nt.update(tests=tt.get("tests", False), ui=tt.get("ui", False), external=tt.get("external") or [])
            d["tasks"].append(nt)
            tt["rest"] = ""
            title = tt["title"]
    if rest:
        r.task_dir(fid).mkdir(parents=True, exist_ok=True)
        (r.task_dir(fid) / "knowledge.md").write_text(
            "# %s - Finish: %s\n\nTask %s ran past its time box and left this part for a follow-on task.\n\n"
            "## What is left\n\n%s\n\n## Read first\n\n- %s - the brief this continues\n- %s - what %s did\n" % (
                fid, title, tid, rest, r.task_dir(tid) / "knowledge.md", r.task_dir(tid) / "changes.md", tid))
        r.log("queued %s for what %s left" % (fid, tid))
    with GIT_LOCK:
        if wt.exists():
            run(["git", "worktree", "remove", "--force", wt], cwd=r.project, check=False)
        r.log("merged %s" % tid)
        chain = [tid]
        while find(data, chain[-1]).get("parent") and len(chain) <= len(data["tasks"]):
            chain.append(find(data, chain[-1])["parent"])
        for done in chain:
            if done != tid and r.wt(done).exists():
                run(["git", "worktree", "remove", "--force", r.wt(done)], cwd=r.project, check=False)
            res = run(["git", "branch", "-D", r.task_branch(done)], cwd=r.project, check=False)
            r.log("deleted the branch %s" % r.task_branch(done) if res.returncode == 0 else
                  "could not delete the branch %s: %s" % (r.task_branch(done), (res.stderr or res.stdout).strip()[-200:]))
    sync_pr(r)


class Integrator(threading.Thread):
    """Merges finished tasks and runs the gate one at a time, off the scheduler's loop, so agents keep starting and
    finishing while a long gate runs."""

    def __init__(self, r):
        super().__init__(daemon=True)
        self.r, self.busy, self.lock = r, set(), threading.Lock()
        self.queue = []
        self.wake = threading.Event()

    def submit(self, tid):
        with self.lock:
            if tid in self.busy:
                return
            self.busy.add(tid)
            self.queue.append(tid)
        self.wake.set()

    def idle(self):
        with self.lock:
            return not self.busy

    def run(self):
        while True:
            self.wake.wait()
            with self.lock:
                tid = self.queue.pop(0) if self.queue else None
                if not self.queue:
                    self.wake.clear()
            if tid is None:
                continue
            try:
                with self.r.edit() as d:
                    find(d, tid)["merge_state"] = "merging"
                integrate(self.r, tid)
            except Exception as e:
                self.r.log("integrate %s failed: %r" % (tid, e))
                with self.r.edit() as d:
                    find(d, tid).update(status="waiting_on_you", question_kind="stalled",
                                        question="Merging %s into the run branch failed: %s" % (tid, e))
            finally:
                try:
                    with self.r.edit() as d:
                        tt = find(d, tid)
                        if tt.get("merge_state") == "merging":
                            tt["merge_state"] = ""
                except Exception as e:
                    self.r.log("could not reset %s after merging: %r" % (tid, e))
                with self.lock:
                    self.busy.discard(tid)
            self.r.poke()


def request_title(request, n=72):
    first = re.split(r"(?<=[.!?])\s|\n", (request or "").strip(), maxsplit=1)[0].strip().rstrip(".")
    if len(first) <= n:
        return first
    return first[:n].rsplit(" ", 1)[0].rstrip(",;:") + "..."


def written_pr(r):
    """(title, body) of pr.md; the title is its first line when that is a `# ` heading."""
    p = r.dir / "pr.md"
    if not nonempty(p):
        return "", ""
    text = p.read_text().strip()
    first, _, rest = text.partition("\n")
    if first.startswith("# "):
        return first[2:].strip(), rest.strip()
    return "", text


def plan_title(r, data):
    plan = r.dir / "plan.md"
    if plan.exists():
        for line in plan.read_text().splitlines():
            if line.startswith("# "):
                return line[2:].strip()
    return data.get("title") or request_title(data.get("request")) or data["name"]


def plan_section(r, heading):
    plan = r.dir / "plan.md"
    m = re.search(r"^## %s[ \t]*\n(.*?)(?=^## |\Z)" % re.escape(heading), plan.read_text(), re.M | re.S) if plan.exists() else None
    return m.group(1).strip() if m else ""


def merged_ids(data):
    return sorted(t["id"] for t in data["tasks"] if t["type"] in WORK and t.get("merged"))


def queue_writer(r):
    # Once every task has merged, a writer describes the change for its reviewers. A quick run's builder writes it.
    data = r.load()
    ids = merged_ids(data)
    if data.get("quick") or data.get("mode") != "build" or data["status"] == "paused" or not data.get("pr_url") or not ids \
            or data.get("described") == ids or any(t["status"] in OPEN + ("waiting_on_you",) for t in data["tasks"]) \
            or any(t["type"] in WORK and t["status"] == "done" and not t.get("merged") for t in data["tasks"]):
        return
    with r.edit() as d:
        tid = next_id(d, "W")
        d["tasks"].append(new_task(tid, "Write the pull request description", "pr", size="S"))
        d["described"] = ids
        work = [t for t in d["tasks"] if t["type"] in WORK and not t.get("parent")]
    (r.dir / "pr.md").unlink(missing_ok=True)
    r.task_dir(tid).mkdir(parents=True, exist_ok=True)
    (r.task_dir(tid) / "knowledge.md").write_text(
        "# %s - Write the pull request description\n\n## The owner's words\n\n%s\n\n## Tasks\n\n%s\n" % (
            tid, owner_words(data), "\n".join("- %s: %s%s - %s" % (t["id"], t["title"], " (skipped)" if t["status"] == "skipped"
                                                               else "", r.task_dir(t["id"]) / "changes.md") for t in work)))
    r.log("queued %s to write the pull request description" % tid)


def pr_body(r, data):
    # The written description once every task has merged; until then the goal and what is merged so far
    _, written = written_pr(r)
    done = data.get("quick") or data.get("described") == merged_ids(data)
    if data["status"] == "finished" and done and written:
        out = [written, ""]
    else:
        tasks = [t for t in data["tasks"] if t["type"] in WORK and not t.get("parent") and t["status"] != "skipped"]
        goal = plan_section(r, "Goal") or (data.get("request", "").strip() if data.get("quick") else "")
        out = ([goal, ""] if goal else []) + ["Work in progress: %d of %d merged." % (
            sum(1 for t in tasks if t.get("merged")), len(tasks)), ""]
        out += ["- [%s] %s" % ("x" if t.get("merged") else " ", t["title"]) for t in tasks] + [""]
    return "\n".join(out).strip() + "\n"


GH_REMOTE_RE = re.compile(r"^(?:\w+://)?(?:[^@/]+@)?([^/:]+)[:/](.+)$")


def repo_slug(cwd):
    """The `--repo` args for origin's GitHub repository: without it, an `upstream` remote makes `gh` target
    upstream instead when there's no `gh repo set-default`."""
    res = run(["git", "remote", "get-url", "origin"], cwd=cwd, check=False)
    if res.returncode:
        return []
    m = GH_REMOTE_RE.match(res.stdout.strip())
    if not m or "." not in m.group(1):
        return []
    path = m.group(2).rstrip("/")
    if path.endswith(".git"):
        path = path[:-4]
    parts = path.split("/")
    if len(parts) != 2 or not all(parts):
        return []
    return ["--repo", "%s/%s" % (m.group(1), path)]


def push_branch(r, branch):
    if run(["git", "remote", "get-url", "origin"], cwd=r.project, check=False).returncode:
        r.log("push skipped: the repository has no origin remote")
        return False
    res = run(["git", "push", "-u", "origin", branch], cwd=r.project, check=False)
    if res.returncode:
        r.log("push failed: %s" % (res.stderr or res.stdout).strip()[-300:])
        return False
    r.log("pushed %s" % branch)
    return True


def sync_pr(r, push=True):
    # push=False only refreshes the body of the run's pull request, when it has one
    if not r.cfg.get("push"):
        return
    data = r.load()
    if data.get("mode") != "build" or not data.get("branch") or (not push and not data.get("pr_url")):
        return
    branch = data["branch"]
    if push and not push_branch(r, branch):
        return
    if not r.cfg.get("pr") or not shutil.which("gh"):
        return
    repo = repo_slug(r.project)
    body = r.brain / "pr-body.md"
    body.write_text(pr_body(r, data))
    title, _ = written_pr(r)
    retitle = ["--title", title] if title and data["status"] == "finished" else []
    if not push:
        res = run(["gh", "pr", "edit", data["pr_url"], *repo, "--body-file", body, *retitle], cwd=r.project, check=False)
        if res.returncode:
            r.log("pull request update failed: %s" % (res.stderr or res.stdout).strip()[-300:])
        return
    view = run(["gh", "pr", "view", branch, *repo, "--json", "url,state"], cwd=r.project, check=False)
    pr = json.loads(view.stdout) if view.returncode == 0 and view.stdout.strip() else {}
    if pr.get("state") == "MERGED":  # a merge right after the run finished: never open a second pull request
        return
    if pr.get("state") == "OPEN":
        res = run(["gh", "pr", "edit", branch, *repo, "--body-file", body, *retitle], cwd=r.project, check=False)
        url = pr.get("url", "")
    else:
        res = run(["gh", "pr", "create", "--draft", "--head", branch, "--base", data["base"], *repo,
                   "--title", title or plan_title(r, data), "--body-file", body], cwd=r.project, check=False)
        url = (res.stdout.strip().splitlines() or [""])[-1] if res.returncode == 0 else ""
    if res.returncode:
        r.log("pull request update failed: %s" % (res.stderr or res.stdout).strip()[-300:])
    if url and url != data.get("pr_url"):
        with r.edit() as d:
            d["pr_url"] = url
        r.log("pull request: %s" % url)


def open_pr(r, data):
    # The run's first change: GitHub refuses a pull request without commits, so an empty start commit opens it at approval
    if not r.cfg.get("push") or not r.cfg.get("pr"):
        r.log("pull request skipped: push or pr is off")
        return
    if run(["git", "remote", "get-url", "origin"], cwd=r.project, check=False).returncode:
        r.log("pull request skipped: the repository has no origin remote")
        return
    if not shutil.which("gh"):
        r.log("pull request skipped: gh is not on PATH")
        return
    with GIT_LOCK:
        wt = ensure_run_wt(r, data)
        msg = "Start %s." % plan_title(r, data).rstrip(".")
        if msg not in git(wt, "log", "--format=%s", "%s..HEAD" % data["base"]).splitlines():
            run(["git", *git_ident(wt), "commit", "--allow-empty", "--no-verify", "-m", msg], cwd=wt)
    sync_pr(r)


def next_jobs(r, data, jobs):
    tasks = data["tasks"]
    by = {t["id"]: t for t in tasks}
    busy = {j.tid for j in jobs.values()}
    out = [("audit", t["id"]) for t in tasks if t["status"] == "audit" and t["id"] not in busy]
    if not any(by[x]["type"] == "plan" for x in busy if x in by):
        for t in tasks:
            if t["type"] == "plan" and t["status"] == "queue" and deps_met(t, by):
                out.append(("work", t["id"]))
                break
    out += [("work", t["id"]) for t in tasks if t["type"] in ("shots", "map", "pr") and t["status"] == "queue" and t["id"] not in busy]
    if data.get("plan_approved") and data.get("mode") == "build":
        # Only builds take build slots: an officer's audit of a task doesn't
        running = [by[j.tid] for j in jobs.values() if j.kind == "work" and j.tid in by and by[j.tid]["type"] in WORK]
        slots = max(1, int(r.cfg["max_parallel"])) - len(running)
        for t in tasks:
            if slots <= 0:
                break
            if t["type"] in WORK and t["status"] == "queue" and t["id"] not in busy and not t.get("pending_approval") \
                    and deps_met(t, by) and not any(overlap(t, b) for b in running):
                out.append(("work", t["id"]))
                running.append(t)
                slots -= 1
    return out


def sleep_poke(r, secs):
    poke = r.brain / "poke"
    before = poke.stat().st_mtime if poke.exists() else 0
    end = time.time() + secs
    while time.time() < end:
        time.sleep(0.25)
        if poke.exists() and poke.stat().st_mtime != before:
            return


def last_activity(job):
    """When the agent's transcript, or one of its subagents' transcripts, last changed."""
    if not getattr(job, "transcript", None) or not job.transcript.exists():
        job.transcript = transcript(job.session) if job.session else None
    if not job.transcript:
        return 0
    times = [job.transcript.stat().st_mtime]
    sub = job.transcript.parent / job.transcript.stem / "subagents"
    if sub.is_dir():
        times += [p.stat().st_mtime for p in sub.glob("*.jsonl")]
    return max(times)


def watch(r, data, jobs):
    """Zero-token supervision: stop agents that made no progress, nudge builders past their time box, answer agents'
    questions with their defaults at the deadline, and let a full-auto run's plan additions start."""
    nowt = time.time()
    stall = float(r.cfg.get("stall_minutes") or 0) * 60
    box = r.cfg.get("time_box") or {}
    by = {t["id"]: t for t in data["tasks"]}
    for job in jobs.values():
        t = by.get(job.tid)
        if not t or job.kind != "work":
            continue
        if stall and nowt - job.t0 > stall and nowt - getattr(job, "checked", 0) > 60 and not job.stalled:
            job.checked = nowt
            last = last_activity(job)
            if last and nowt - last > stall:
                job.stalled = True
                r.log("%s made no progress for %d minutes; stopping its agent" % (job.tid, (nowt - last) // 60))
                kill_group(job.pid)
        limit = float(box.get(t.get("size"), 0) or 0) * 60 * 1.5
        if job.role == "builder" and limit and not t.get("boxed") and t.get("minutes", 0) * 60 + nowt - job.t0 > limit:
            with r.edit() as d:
                tt = find(d, job.tid)
                tt["boxed"] = True
                tt["inbox"].append(
                    "You have worked about %d minutes against a %d-minute time box for a size-%s task. Finish the part "
                    "that is coherent now; record what is left with `coord task rest \"<what is left>\"` (it becomes a "
                    "follow-on task), then write changes.md and finish as usual."
                    % ((t.get("minutes", 0) * 60 + nowt - job.t0) // 60, box[t["size"]], t["size"]))
            r.log("%s is past 1.5x its time box; told it to wrap up" % job.tid)
    for t in data["tasks"]:
        deadline = question_deadline(r, data, t)
        if deadline and dt.datetime.now().astimezone() >= deadline:
            with r.edit() as d:
                tt = find(d, t["id"])
                if tt["status"] != "waiting_on_you" or not tt.get("question_default"):
                    continue
                tt.update(answer=tt["question_default"], answered_by_default=True, status="queue", resume=True, attempts=0)
                add_owner_note(d, "default", "No answer by the deadline, so %s's default applies: %s"
                               % (tt["id"], tt["question_default"]), tt["id"])
                d["status"] = derive_status(d)
            r.log("%s: no answer by the deadline, so it goes on with its default" % t["id"])
    if data.get("full_auto") and pending_changes(data) and not any(t["type"] == "plan" and t["status"] in OPEN
                                                                    for t in data["tasks"]):
        with r.edit() as d:
            for t in pending_changes(d):
                t["pending_approval"] = False
        r.log("full auto: the plan's additions start without waiting")


def cmd_scheduler(a):
    r = Run(a.project, a.run)
    (r.brain / "logs").mkdir(parents=True, exist_ok=True)
    hold = try_lock(r.brain / "scheduler.lock")  # one scheduler per run, even when two commands start one at once
    if not hold:
        return
    code = ROOT / "bin" / "coord"
    stamp = code.stat().st_mtime
    jobs = adopt_jobs(r)
    r.set_state(scheduler_pid=os.getpid(), scheduler_start=proc_start(os.getpid()),
                agents={k: j.record() for k, j in jobs.items()})
    write_agent_files(r)
    stop = []
    signal.signal(signal.SIGTERM, lambda *_: stop.append(1))
    adopted = {j.tid for j in jobs.values()}
    with r.edit() as d:
        for t in d["tasks"]:
            if t["status"] in ("in_progress", "review") and t["id"] not in adopted:
                t["status"], t["resume"] = "queue", True
                t["resume_msg"] = "Your session was interrupted. Check what is already done, then continue and finish the task."
            if t.get("merge_state") == "merging":
                t["merge_state"] = ""
    integ = Integrator(r)
    integ.start()
    announced, pr_sig, pr_tried, handover = None, None, False, ""
    r.log("scheduler up (pid %d%s)" % (os.getpid(), "; adopted %s" % ", ".join(sorted(adopted)) if adopted else ""))
    while not stop:
        for key, job in list(jobs.items()):
            if job.poll() is not None:
                jobs.pop(key)
                try:
                    finish_job(r, job)
                except Exception as e:  # keep scheduling; surface it on the task
                    r.log("finish %s failed: %r" % (key, e))
        data = r.load()
        if data.get("terminating"):
            break
        if integ.idle() and ((r.brain / "restart").exists() or code.stat().st_mtime != stamp):
            handover = "asked to restart" if (r.brain / "restart").exists() else "coord was updated"
            break
        if data["status"] != "paused":
            try:
                watch(r, data, jobs)
            except Exception as e:
                r.log("watch failed: %r" % e)
            data = r.load()
            holding = any(t.get("merge_state") == "gate-red" for t in data["tasks"])
            for t in data["tasks"]:
                if t["type"] in WORK and t["status"] == "done" and not t.get("merged") \
                        and t.get("merge_state") not in ("fixing", "gate-red", "merging") and (not holding or t.get("parent")):
                    integ.submit(t["id"])
            try:
                queue_writer(r)
            except Exception as e:
                r.log("queueing the pull request writer failed: %r" % e)
            data = r.load()
            for kind, tid in next_jobs(r, data, jobs):
                key = "%s:%s" % (kind, tid)
                if key in jobs:
                    continue
                try:
                    jobs[key] = start_job(r, kind, tid)
                except Exception as e:
                    r.log("start %s failed: %r" % (key, e))
                    with r.edit() as d:
                        tt = find(d, tid)
                        tt.update(status="waiting_on_you", question_kind="stalled",
                                  question="Could not start %s: %s" % (tid, e))
            if data.get("plan_approved") and data.get("mode") == "build" and not data.get("pr_url") and not pr_tried:
                pr_tried = True
                try:
                    open_pr(r, data)
                except Exception as e:
                    r.log("opening the pull request failed: %r" % e)
        with r.edit() as d:
            d["status"] = derive_status(d, bool(jobs) or not integ.idle())
            status = d["status"]
            data = d
        if status != announced:
            r.log("status %s" % status)
            write_catalog(r.project)
            if status in WAIT_STATES and announced is not None:
                notify("coord · %s" % r.name, summary(data))
            if status == "finished":
                try:
                    record_metrics(r, data)
                except Exception as e:
                    r.log("recording the run's metrics failed: %r" % e)
            announced = status
        r.set_state(agents={k: j.record() for k, j in jobs.items()})
        sig = [status] + [(t["id"], t["status"], bool(t.get("merged"))) for t in data["tasks"]]
        stopping = not jobs and integ.idle() and status in ("finished", "planned", "paused")
        try:
            if stopping and status == "finished":
                sync_pr(r)
            elif sig != pr_sig and data.get("pr_url"):
                sync_pr(r, push=False)
        except Exception as e:
            r.log("pull request update failed: %r" % e)
        pr_sig = sig
        if stopping:
            break
        sleep_poke(r, 2.0)
    if handover:
        # The agents keep running; the new scheduler adopts them by pid and start time
        r.log("handing over to a new scheduler: %s" % handover)
        r.set_state(scheduler_pid=0, scheduler_start="", agents={k: j.record() for k, j in jobs.items()})
        (r.brain / "restart").unlink(missing_ok=True)
        hold.close()
        start_daemon(r, "scheduler")
        return
    for job in jobs.values():
        kill_group(job.pid)
    r.set_state(scheduler_pid=0, scheduler_start="", agents={})
    r.log("scheduler down")
    hold.close()


def start_daemon(r, which):
    if r.alive(which):
        return False
    (r.brain / "logs").mkdir(parents=True, exist_ok=True)
    log = open(r.brain / "logs" / ("%s.out" % which), "a")
    spawn(coord_argv() + ["_%s" % which, "--project", str(r.project), "--run", r.name],
          cwd=str(r.project), stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
    log.close()
    if which == "viewer":
        for _ in range(40):
            if r.alive("viewer") and r.state().get("viewer_port"):
                break
            time.sleep(0.1)
    return True


def viewer_url(r):
    port = r.state().get("viewer_port")
    return "http://127.0.0.1:%s/" % port if port else ""


# ---------------------------------------------------------------- owner commands

FULL_AUTO_TAG = re.compile(r"\s*<\s*full[\s_-]*auto\s*>", re.I)


def cmd_start(a):
    project = project_root()
    request = Path(a.request_file).read_text() if a.request_file else " ".join(a.request or [])
    # `<full auto>` at the very start turns full auto on; it is a switch, not part of the request
    tag = FULL_AUTO_TAG.match(request)
    full_auto = bool(a.full_auto or tag)
    request = request[tag.end():] if tag else request
    if not request.strip():
        raise Fail("empty request")
    if a.quick and a.plan_only:
        raise Fail("a quick run builds at once; it can't be plan-only")
    name = slug(a.name or " ".join(request.split()[:6]))
    r = Run(project, name)
    if r.tasks_file.exists():
        raise Fail("a coordinator named %r already exists here; pick another name, or `coord resume %s`" % (name, name))
    if not claude_found(r.cfg):
        raise Fail("`%s` is not on PATH" % r.cfg["claude"])
    if not a.skip_selftest:
        ok, why = selftest(r.cfg, cached=True)
        if not ok:
            raise Fail("Claude Code can't start Coordinator's agents on this machine (%s). `coord selftest` shows the "
                       "details." % why)
    ensure_store(project)
    base = r.cfg["base_branch"] or git(project, "rev-parse", "--abbrev-ref", "HEAD")
    data = {"name": name, "request": request.strip(), "mode": "plan" if a.plan_only else "build",
            "status": "planning", "plan_approved": False, "base": base, "branch": a.branch or "coord/%s" % name,
            "full_auto": full_auto, "created": now(), "updated": now(), "version": coord_version(), "tasks": []}
    if a.quick:
        title = request_title(request)
        t = new_task("T1", title, "build", size=a.size or "M", model=a.model or "", effort=a.effort or "")
        t.update(tests=a.tests == "on", ui=a.ui == "on")
        data.update(quick=True, plan_approved=True, status="running", title=title, tasks=[t])
    else:
        plan = new_task("T0", "Plan the work", "plan", model=a.model or "", effort=a.effort or "")
        data["tasks"] = [plan]
    if not a.plan_only:
        ensure_branch(r, data)
    first = data["tasks"][0]["id"]
    r.task_dir(first).mkdir(parents=True)
    write_json(r.tasks_file, data)
    if not a.plan_only and r.cfg.get("push"):
        push_branch(r, data["branch"])
    if a.quick:
        (r.task_dir(first) / "knowledge.md").write_text(
            "# T1 - %s\n\n## The owner's words\n\n%s\n\n## Quick run\n\nThere is no planner and no plan: this brief "
            "is the owner's request. Find the code it touches, state your intent with `coord task intent` before "
            "your first edit, then build exactly what the words ask for.\n\n## Done when\n\n- Everything the owner's "
            "words ask for is done and works, and nothing they didn't ask for is.\n- The check passes, and the "
            "reviewer's must-fix findings are fixed.\n" % (data["title"], request.strip()))
    else:
        (r.task_dir("T0") / "knowledge.md").write_text(
            "# T0 - Plan the work\n\n## The owner's request, word for word\n\n%s\n\n## Mode\n\n%s\n" % (
                request.strip(), "Plan only: goals, milestones and tasks that later runs will build."
                if a.plan_only else "Build: the owner approves your plan, then the tasks are built."))
    write_catalog(project)
    start_daemon(r, "scheduler")
    start_daemon(r, "viewer")
    url = viewer_url(r)
    if url and not a.no_open:
        open_url(url)
    print("started %s - %s. Live page: %s" % (name, "building (quick run)" if a.quick else "planning",
                                               url or "(viewer failed to start)"))
    if full_auto:  # its own line: start_followups reads the line above
        print("full auto: on - /coordinate decides for you, merges when the run is done and ends it")


def ensure_store(project):
    store = project / STORE
    store.mkdir(exist_ok=True)
    exclude = Path(git(project, "rev-parse", "--path-format=absolute", "--git-common-dir")) / "info" / "exclude"
    exclude.parent.mkdir(exist_ok=True)
    text = exclude.read_text() if exclude.exists() else ""
    if "/%s/" % STORE not in text.split("\n"):
        exclude.write_text(text + ("" if text.endswith("\n") or not text else "\n") + "/%s/\n" % STORE)
    cfg = store / "config.json"
    if not cfg.exists():
        write_json(cfg, {"base_branch": "", "gate": "", "gate_cwd": ".", "setup": "",
                         "dev": {"command": "", "cwd": ".", "ready_path": "/"}, "max_parallel": 3})


def cmd_status(a):
    r = pick_run(a.run)
    data = r.load()
    if a.text:
        print_status_text(r, data)
        return
    start_daemon(r, "viewer")
    url = viewer_url(r)
    if url and not a.no_open:
        open_url(url)
    print(summary(data, r.alive("scheduler")) + (" · %s" % url if url else ""))


def run_overlaps(r, data):
    """Other open runs of this project whose tasks may change the same files as this run's."""
    mine = [t for t in data["tasks"] if t["type"] in WORK and t["status"] not in ("done", "skipped")]
    out = []
    for other in list_runs(r.project):
        if other.name == r.name:
            continue
        od = read_json(other.tasks_file) or {}
        if od.get("status") in ("finished", "planned") or od.get("mode") != "build":
            continue
        theirs = [t for t in od.get("tasks", []) if t.get("type") in WORK and t.get("status") not in ("skipped",)
                  and not t.get("merged") and t.get("files")]
        hits = sorted({f for a in mine for b in theirs if a.get("files") and overlap(a, b) for f in b["files"]})
        if hits:
            out.append({"run": other.name, "files": hits[:8]})
    return out


def print_status_text(r, data):
    print(summary(data, r.alive("scheduler")))
    url = viewer_url(r)
    if url:
        print("live page: %s" % url)
    if data.get("full_auto"):
        print("FULL AUTO: on - the owner is away; /coordinate decides every item below for them")
    acts = owner_actions(r, data)
    if acts:
        print("WAITING ON YOU:")
        for i, x in enumerate(acts, 1):
            who = "%s (%s) asks: " % (x["task"], x["question_kind"]) if x["kind"] == "question" else \
                "%s: " % x["task"] if x.get("task") else ""
            print("  %d. %s%s - %s" % (i, who, x["text"], x["do"]))
    if not data.get("plan_approved") and data["status"] == "waiting_on_you":
        plan = r.dir / "plan.md"
        print("PLAN READY: %s" % plan)
        if plan.exists():
            keep, out = False, []
            for line in plan.read_text().splitlines():
                if line.startswith("## "):
                    keep = line[3:].strip().lower() in ("goal", "questions for the owner", "out of scope", "not in this run")
                if keep:
                    out.append(line)
            print("\n".join(out[:60]))
        print("TASKS:")
        for t in data["tasks"]:
            if t["type"] in WORK and t["status"] != "skipped":
                print("  %s %s [%s, %s/%s%s] after: %s" % (t["id"], t["title"], t["size"], t.get("model") or "default",
                                                         t.get("effort") or "default", ", tests on" if t.get("tests") else "",
                                                         ", ".join(t["depends_on"]) or "-"))
        n, depth = critical_path(data)
        if n:
            print("SHAPE: %d task%s, up to %d at once, %d after one another at most"
                  % (n, "s" if n != 1 else "", min(n, int(r.cfg["max_parallel"])), depth))
        audits = sorted(r.dir.glob("plan-audit-*.md"))
        if audits:
            print("OFFICER'S REPORT: %s" % audits[-1])
        for o in run_overlaps(r, data):
            print("OVERLAPS WITH OPEN RUN %s: %s" % (o["run"], ", ".join(o["files"])))
        if data.get("followups"):
            print("FOLLOW-UP RUNS:")
            for f in data["followups"]:
                print("  %s - %s" % (followup_line(data, f), f["note"]))
    elif data.get("plan_approved"):
        for f in data.get("followups") or []:
            print("FOLLOW-UP %s: %s" % (f.get("run") or f["name"], followup_line(data, f)))
        for t in data["tasks"]:
            if t.get("intent") and t["status"] not in ("done", "skipped"):
                print("%s INTENT: %s" % (t["id"], t["intent"]))
    if (data.get("design") or {}).get("choice"):
        print("DESIGN LANGUAGE: %s" % design_line(data))
    # Once finished, the pull request and the outside files are in the list above. A family's lines also show each
    # run's status, so they stay.
    prs = pull_requests(r, data)
    if len(prs) > 1 and any(p["url"] for p in prs):
        print("PULL REQUESTS:")
        for p in prs:
            print("  %s · %s · %s · %s" % (p["repo_name"], p["run"], "merged" if p["merged"] else p["status"],
                                           p["url"] or "no pull request yet"))
    elif data.get("pr_url") and data["status"] != "finished":
        print("PULL REQUEST: %s" % data["pr_url"])
    external = sorted({f for t in data["tasks"] if t.get("status") == "done" for f in (t.get("external") or [])})
    if external and data["status"] != "finished":
        print("UPDATED OUTSIDE THE REPO (not committed by coord): %s" % ", ".join(external))
    if data["status"] == "finished":
        if data.get("branch"):
            print("RUN BRANCH: %s (from %s)" % (data["branch"], data["base"]))
        for t in data["tasks"]:
            print("  %s %s - %s, %s, %s tokens" % (t["id"], t["title"], t["status"], human_minutes(t.get("minutes")),
                                                  human_tokens(t.get("tokens"))))


def cmd_wait(a):
    r = pick_run(a.run)
    # Also return when something new waits on the owner (a manual step, a follow-up run), not only on a status change,
    # and when the owner switches full auto. The scheduler's own item is left to the check below, which waits out a
    # restart. With --new, what already waits doesn't count: it is armed while the owner is being asked.
    keys = lambda d: {x["key"] for x in owner_actions(r, d, True)}
    data = r.load()
    seen, status, auto = keys(data), data["status"], bool(data.get("full_auto"))
    while True:
        try:
            data = r.load()
        except Fail:  # merged or terminated from the live page meanwhile
            print("%s has ended: it was terminated" % r.name)
            return
        now_keys = keys(data)
        if now_keys - seen or bool(data.get("full_auto")) != auto or \
                (data["status"] != status if a.new else data["status"] in WAIT_STATES):
            break
        seen &= now_keys  # an item settled and then asked again is new
        if not r.alive("scheduler"):
            time.sleep(3)
            if not r.alive("scheduler") and r.load()["status"] not in WAIT_STATES:
                break
        time.sleep(4)
    print_status_text(r, r.load())


def do_approve(r, note=""):
    with r.edit() as d:
        plans = [t for t in d["tasks"] if t["type"] == "plan"]
        if any(t["status"] == "audit" for t in plans):
            raise Fail("the hallucination officer is still checking the plan")
        asking = [t["id"] for t in plans if t["status"] == "waiting_on_you" and t.get("question_kind") != "officer"]
        if asking:
            raise Fail("the plan is not ready yet: %s waits for you first (`coord status --text` says what to do)" % asking[0])
        for t in plans:
            if t["status"] == "waiting_on_you":
                t["status"], t["question"], t["question_kind"] = "done", "", ""
        if any(t["type"] == "plan" and t["status"] in OPEN for t in d["tasks"]):
            raise Fail("the plan is not ready yet")
        if note:
            add_owner_note(d, "answer", note)
        was = d.get("plan_approved")
        d["plan_approved"] = True
        changes = pending_changes(d)
        for t in changes:
            t["pending_approval"] = False
        if was and not changes:
            raise Fail("nothing waits for your approval")
        d["status"] = derive_status(d)
    r.poke()
    start_daemon(r, "scheduler")
    return start_followups(r)


def approve_with(r, answers, comment):
    """The live page's approval: defaults and no comment approve; anything else goes back to the planner."""
    lines = ["%s. %s - %s%s" % (a.get("n") or i + 1, a["question"], a["answer"], " (default)" if a.get("default") else "")
             for i, a in enumerate(answers)]
    text = "Answers to the plan's questions:\n" + "\n".join(lines) if lines else ""
    if not comment and all(a.get("default") for a in answers):
        return do_approve(r, text)
    do_add(r, "\n\n".join(x for x in (text, "Comment: " + comment if comment else "") if x))
    return []


def followup_repo(r, path):
    p = Path(path).expanduser()
    if not path or not p.is_absolute():
        raise Fail("give the repo's absolute path: coord task followup --repo \"<absolute repo path>\" \"<note>\"")
    out = run(["git", "rev-parse", "--path-format=absolute", "--show-toplevel", "--git-common-dir"], cwd=p,
              check=False) if p.is_dir() else None
    if not out or out.returncode or Path(out.stdout.split("\n")[0]).resolve() != p.resolve():
        raise Fail("%s is not the top folder of a git repository" % p)
    repo = Path(out.stdout.split("\n")[1]).parent.resolve()
    if repo == r.project:
        raise Fail("%s is this run's own repo; add a task instead" % repo)
    return repo


def followup_line(data, f):
    if f.get("status") == "started":
        return "%s · %s" % (f["repo"], f.get("url") or "live page: `coord status %s` in that repo" % f["run"])
    if f.get("status") == "failed":
        return "%s · failed to start: %s" % (f["repo"], f.get("error"))
    if data.get("mode") != "build":
        return "%s · not started (plan-only run)" % f["repo"]
    return "%s · %s" % (f["repo"], "starting" if f.get("status") == "starting" else "starts when you approve")


def start_followups(r):
    """Start each pending follow-up run in its own repo with the owner's full words. Failures are recorded, never raised."""
    with r.edit() as d:
        if d.get("mode") != "build":
            return []
        todo = [f for f in d.get("followups") or [] if f.get("status") == "pending"]
        for f in todo:
            f["status"] = "starting"
        words = owner_words(d)
        auto = ["--full-auto"] if d.get("full_auto") else []  # the owner is away for every run of the family
    env = other_repo_env()
    for f in todo:
        try:
            name, n = f["name"], 2
            while (Path(f["repo"]) / STORE / name / "tasks.json").exists():
                name, n = "%s-%d" % (slug(f["name"], 37), n), n + 1
            req = r.dir / ("followup-%s.md" % name)
            req.write_text("%s\n\n[coordinator context: started by run '%s' in %s when the owner approved its plan. This "
                           "run's part: %s. The rest is built there. This run's own plan still waits for the owner's approval.]\n"
                           % (words, r.name, r.project, f["note"].rstrip(".")))
            p = subprocess.run(coord_argv() + ["start", "--name", name, "--request-file",
                                str(req), "--no-open"] + auto, cwd=f["repo"], env=env, text=True, capture_output=True,
                               stdin=subprocess.DEVNULL, timeout=300)
            m = re.search(r"^started (\S+) - [^.]*\. Live page: (\S+)", p.stdout, re.M)
            if p.returncode or not m:
                raise Fail((p.stderr or p.stdout).strip()[-300:] or "coord start exited with %d" % p.returncode)
            f.update(status="started", run=m.group(1), url=m.group(2) if m.group(2).startswith("http") else "", error="")
            r.log("follow-up run %s started in %s" % (f["run"], f["repo"]))
            try:
                with Run(f["repo"], f["run"]).edit() as fd:
                    fd["parent"] = {"repo": str(r.project), "run": r.name}
            except Exception as e:  # the run did start; only the link back to this one is missing
                r.log("could not record the parent of follow-up run %s: %s" % (f["run"], e))
        except Exception as e:
            f.update(status="failed", error=str(e).replace("coord: ", "", 1))
            r.log("follow-up run for %s failed to start: %s" % (f["repo"], f["error"]))
    if todo:
        result = {f["repo"]: f for f in todo}
        with r.edit() as d:
            for f in d.get("followups") or []:
                if f["repo"] in result and f.get("status") == "starting":
                    f.update(result[f["repo"]])
    return todo


def do_answer(r, tid, text):
    with r.edit() as d:
        t = find(d, tid)
        if t["status"] != "waiting_on_you":
            raise Fail("%s is not waiting for an answer" % tid)
        t.update(answer=text, status="queue", resume=True, attempts=0, answered_by_default=False)
        add_owner_note(d, "answer", text, tid)
        if t.get("question_kind") == "officer":
            t["audit_round"] = 0

        d["status"] = derive_status(d)
    r.poke()
    start_daemon(r, "scheduler")


def do_accept(r, tid):
    with r.edit() as d:
        t = find(d, tid)
        if t["status"] not in ("waiting_on_you", "audit"):
            raise Fail("%s has nothing to accept" % tid)
        if t.get("question_kind") == "gate":
            t["gate_override"] = True  # merge it with the gate red, as the owner said
        t.update(status="done", question="", question_kind="")
        d["status"] = derive_status(d)
    r.poke()
    start_daemon(r, "scheduler")


def do_todo_done(r, n):
    with r.edit() as d:
        x = next((x for x in d.get("todos") or [] if x["n"] == n), None)
        if not x:
            raise Fail("no manual step %s" % n)
        x.update(done=True, done_at=now())
    r.poke()


def cmd_todo(a):
    r = pick_run(a.run)
    if a.action == "done":
        if a.n is None:
            raise Fail("say which: coord todo done <n>")
        do_todo_done(r, a.n)
        print("marked %d done" % a.n)
        return
    todos = r.load().get("todos") or []
    for x in todos:
        print("%d. [%s] %s%s" % (x["n"], "done" if x.get("done") else "to do", "%s: " % x["task"] if x.get("task") else "", x["text"]))
    if not todos:
        print("no manual steps recorded")


def do_pause(r):
    with r.edit() as d:
        d["status"] = "paused"
    r.poke()


def do_auto(r, on):
    """Full auto on or off for a run and its follow-up runs. While it is on, /coordinate decides for the owner."""
    names = []
    for p in pull_requests(r, r.load()):
        with Run(p["repo"], p["run"]).edit() as d:
            d["full_auto"] = on
        names.append(p["run"])
    return names


def cmd_auto(a):
    r = pick_run(a.run)
    names = do_auto(r, a.state == "on")
    print("full auto %s for %s%s: %s" % (
        a.state, r.name, " and its follow-up runs %s" % ", ".join(names[1:]) if len(names) > 1 else "",
        "/coordinate decides for you, merges when the run is done and ends it" if a.state == "on"
        else "decisions wait for you again"))


def do_resume(r):
    with r.edit() as d:
        if d["status"] == "paused":
            d["status"] = "running"
        for t in d["tasks"]:
            if t["status"] == "paused":
                t.update(status="queue", resume=True,
                         resume_msg="The run was resumed. Read your resume note (%s) and continue." % (r.task_dir(t["id"]) / "resume.md"))
        d["status"] = derive_status(d)
    start_daemon(r, "scheduler")
    start_daemon(r, "viewer")


def do_tell(r, tid, text):
    with r.edit() as d:
        t = find(d, tid)
        live = t["status"] in ("in_progress", "review")
        if live:
            t["inbox"].append(text)
        add_owner_note(d, "note", text, tid)
    if not live:
        with open(r.task_dir(tid) / "knowledge.md", "a") as f:
            f.write("\n## Note from the owner (%s)\n\n%s\n" % (now()[:16], text))
    r.poke()
    return "delivered to %s at its next step" % tid if live else "added to %s's brief" % tid


def do_restart(r):
    """A new scheduler that adopts the running agents: picks up a changed `coord` without stopping any work."""
    if r.alive("scheduler"):
        r.brain.mkdir(parents=True, exist_ok=True)
        (r.brain / "restart").write_text(now())
        r.poke()
        for _ in range(150):
            time.sleep(0.2)
            if not (r.brain / "restart").exists():
                break
        return "restarted the scheduler of %s; running agents kept going" % r.name
    start_daemon(r, "scheduler")
    return "started the scheduler of %s" % r.name


def cmd_simple(a):
    r = pick_run(a.run)
    if a.cmd == "approve":
        started = do_approve(r)
        print("approved - building starts now" if r.load()["mode"] == "build" else "approved - the plan is saved; `coord run %s` builds it later" % r.name)
        for f in started:
            print("follow-up run %s: %s" % (f.get("run") or f["name"], followup_line({}, f)))
    elif a.cmd == "accept":
        do_accept(r, a.task)
        print("accepted %s" % a.task)
    elif a.cmd == "answer":
        do_answer(r, a.task, " ".join(a.text))
        print("answered %s - it continues now" % a.task)
    elif a.cmd == "pause":
        do_pause(r)
        print("pausing %s: running agents write a resume note and stop" % r.name)
    elif a.cmd == "resume":
        do_resume(r)
        print("resumed %s · %s" % (r.name, viewer_url(r)))
    elif a.cmd == "restart":
        print(do_restart(r))
    elif a.cmd == "run":
        with r.edit() as d:
            d["mode"] = "build"
            d["status"] = derive_status(d)
        start_daemon(r, "scheduler")
        start_daemon(r, "viewer")
        print("building %s · %s" % (r.name, viewer_url(r)))
        for f in start_followups(r) if r.load().get("plan_approved") else []:
            print("follow-up run %s: %s" % (f.get("run") or f["name"], followup_line({}, f)))
    elif a.cmd == "retry":
        with r.edit() as d:
            t = find(d, a.task)
            t.update(status="queue", attempts=0, resume=False, question="", question_kind="", session="")
            d["status"] = derive_status(d)
        r.poke()
        start_daemon(r, "scheduler")
        print("retrying %s with a fresh agent" % a.task)
    elif a.cmd == "stop":
        with r.edit() as d:
            find(d, a.task)["status"] = "skipped"
            d["status"] = derive_status(d)
        for job in (r.state().get("agents") or {}).values():
            if job.get("task") == a.task:
                kill_group(job.get("pid"), start=job.get("start", ""))
        r.poke()
        print("stopped %s" % a.task)
    elif a.cmd == "tell":
        print(do_tell(r, a.task, " ".join(a.text)))


def do_add(r, text):
    """More work or a change to the plan. Before approval the planner revises the plan; once building, the work
    already approved keeps going while the planner fits the addition in, and only the new tasks wait for approval."""
    data = r.load()
    if data.get("quick"):
        open_ = [t for t in data["tasks"] if t["type"] == "build" and t["status"] in OPEN]
        if open_:
            return do_tell(r, open_[-1]["id"], text)
        with r.edit() as d:
            add_owner_note(d, "addition", text)
            tid = next_id(d)
            last = [t["id"] for t in d["tasks"] if t["type"] == "build" and not t.get("parent")][-1:]
            d["tasks"].append(new_task(tid, request_title(text), "build", last, size="S"))
            d["status"] = derive_status(d)
        r.task_dir(tid).mkdir(parents=True, exist_ok=True)
        (r.task_dir(tid) / "knowledge.md").write_text(
            "# %s - %s\n\n## The owner's words\n\n%s\n\n## Quick run\n\nThe owner added this after the first "
            "change. State your intent with `coord task intent` before your first edit, then build exactly this.\n"
            % (tid, request_title(text), text))
        r.poke()
        start_daemon(r, "scheduler")
        return "added %s for it; it starts now" % tid
    with r.edit() as d:
        add_owner_note(d, "addition", text)
        building = d.get("plan_approved") and d.get("mode") == "build"
        planner = next((t for t in reversed(d["tasks"]) if t["type"] == "plan" and session_exists(t.get("session"))), None)
        how = ("The owner adds this while the run builds: \"%s\". Tasks that are running or done stay as they are. "
               "Add tasks for it (they start once the owner approves them) or change the briefs of queued tasks, "
               "update plan.md, then run `coord task done`." % text) if building else (
               "The owner asks for this change to the plan: \"%s\". Update plan.md, the tasks and their knowledge "
               "files to match, then run `coord task done`." % text)
        if planner and planner["status"] in ("done", "waiting_on_you"):
            planner.update(status="queue", resume=True, audit_round=0, audit_final=False, question="",
                           question_kind="", resume_msg=how)
            tid = planner["id"]
        else:
            tid = next_id(d, "P")
            d["tasks"].append(new_task(tid, "Fit the owner's addition into the plan", "plan"))
        if not building:
            d["plan_approved"] = False
        d["status"] = derive_status(d)
    if tid.startswith("P"):
        r.task_dir(tid).mkdir(parents=True, exist_ok=True)
        (r.task_dir(tid) / "knowledge.md").write_text(
            "# %s - Fit the owner's addition into the plan\n\n## The addition, word for word\n\n%s\n\n"
            "The current plan is plan.md; tasks are in tasks.json. Update the plan, add or change tasks and their "
            "knowledge files. Don't touch tasks that are running or done.\n" % (tid, text))
    r.poke()
    start_daemon(r, "scheduler")
    return ("the planner is fitting it into the plan; work already approved keeps going" if building
            else "the planner is updating the plan; it comes back to you for approval")


def cmd_add(a):
    print(do_add(pick_run(a.run), " ".join(a.text)))


def do_say(r, text, tid=""):
    """One message box for the owner: an answer, a note to a running agent, or more work, decided without a model."""
    data = r.load()
    by = {t["id"]: t for t in data["tasks"]}
    if not tid:
        named = [x for x in re.findall(r"\b([TPSWMB]\d+(?:-\w+)?)\b", text) if x in by]
        asking = [t for t in data["tasks"] if t["status"] == "waiting_on_you"]
        if len(set(named)) == 1:
            tid = named[0]
        elif len(asking) == 1 and not named:
            tid = asking[0]["id"]
    if tid:
        t = by.get(tid)
        if not t:
            raise Fail("no task %s" % tid)
        if t["status"] == "waiting_on_you":
            do_answer(r, tid, text)
            return "answered %s - it continues now" % tid
        if t["status"] in ("in_progress", "review", "queue"):
            return do_tell(r, tid, text)
    if not data.get("plan_approved") and any(t["type"] == "plan" and t["status"] in OPEN for t in data["tasks"]):
        planner = next(t for t in data["tasks"] if t["type"] == "plan" and t["status"] in OPEN)
        if planner["status"] == "in_progress":
            return do_tell(r, planner["id"], text)
    return do_add(r, text)


def cmd_say(a):
    print(do_say(pick_run(a.run), " ".join(a.text), a.task or ""))


def cmd_shots(a):
    r = pick_run(a.run)
    if not r.cfg["dev"].get("command"):
        raise Fail("config.json has no dev.command, so there is no dev server to screenshot")
    with r.edit() as d:
        tid = next_id(d, "S")
        d["tasks"].append(new_task(tid, "Before/after screenshots", "shots", size="S"))
    r.task_dir(tid).mkdir(parents=True, exist_ok=True)
    note = " ".join(a.note or []) or "Show what this run changed."
    (r.task_dir(tid) / "knowledge.md").write_text("# %s - Before/after screenshots\n\n## The owner's note\n\n%s\n" % (tid, note))
    r.poke()
    start_daemon(r, "scheduler")
    print("taking screenshots (%s); the PNG lands in %s" % (tid, r.task_dir(tid)))


def cmd_map(a):
    project = project_root()
    ensure_store(project)
    name = "map-" + dt.datetime.now().strftime("%Y%m%d-%H%M")
    r = Run(project, name)
    if not claude_found(r.cfg):
        raise Fail("`%s` is not on PATH" % r.cfg["claude"])
    note = " ".join(a.note or []).strip()
    exists = (project / STORE / "map" / "AGENTS.md").exists()
    title = "Refresh the project map" if exists else "Build the project map"
    data = {"name": name, "request": note or title + ".", "mode": "map", "status": "running", "plan_approved": True,
            "base": git(project, "rev-parse", "--abbrev-ref", "HEAD"), "branch": "", "created": now(), "updated": now(),
            "tasks": [new_task("M1", title, "map")]}
    r.task_dir("M1").mkdir(parents=True)
    write_json(r.tasks_file, data)
    (r.task_dir("M1") / "knowledge.md").write_text(
        "# M1 - %s\n\nFollow your role: the System map method, written to `.coordinator/map/`.\n\n## The owner's words\n\n%s\n"
        % (title, note or "(none: map the whole project, smallest map that carries the work)"))
    write_catalog(project)
    start_daemon(r, "scheduler")
    start_daemon(r, "viewer")
    url = viewer_url(r)
    if url and not a.no_open:
        open_url(url)
    print("%s - %s. Live page: %s" % (name, title.lower(), url))


def coord_version():
    return (read_json(ROOT / ".claude-plugin" / "plugin.json", {}) or {}).get("version", "?")


def is_link(p):
    try:
        st = os.lstat(p)
    except OSError:
        return False
    return stat.S_ISLNK(st.st_mode) or bool(getattr(st, "st_file_attributes", 0) & stat.FILE_ATTRIBUTE_REPARSE_POINT)


def add_to_user_path(folder):
    with winreg.OpenKey(winreg.HKEY_CURRENT_USER, "Environment", 0, winreg.KEY_READ | winreg.KEY_WRITE) as k:
        try:
            value, kind = winreg.QueryValueEx(k, "Path")
        except FileNotFoundError:
            value, kind = "", winreg.REG_EXPAND_SZ
        parts = [x for x in value.split(";") if x]
        want = os.path.normcase(str(folder)).rstrip("\\")
        if any(os.path.normcase(os.path.expandvars(x)).rstrip("\\") == want for x in parts):
            return False
        winreg.SetValueEx(k, "Path", 0, kind, ";".join(parts + [str(folder)]))
    ctypes.windll.user32.SendMessageTimeoutW(0xFFFF, 0x001A, 0, "Environment", 0x0002, 5000, None)  # WM_SETTINGCHANGE
    return True


def cmd_install(a):
    """Windows install.sh: links /coordinate and `coord` to this checkout, so `git pull` updates them."""
    if not WINDOWS:
        raise Fail("run %s instead" % (ROOT / "install.sh"))
    bin_dir = Path(os.environ.get("COORD_BIN_DIR") or Path.home() / ".local" / "bin")
    skills = Path.home() / ".claude" / "skills"
    link, target = skills / "coordinate", ROOT / "skills" / "coordinate"
    if not shutil.which("claude"):
        print("warning: the claude CLI is not on PATH; agents can't start without it", file=sys.stderr)
    skills.mkdir(parents=True, exist_ok=True)
    if is_link(link):
        if os.path.normcase(os.path.realpath(link)) != os.path.normcase(str(target.resolve())):
            os.rmdir(link) if os.path.isdir(link) or not os.path.exists(link) else os.unlink(link)
    elif link.exists():
        raise Fail("%s already exists and is not a link to Coordinator; move it away, then run this again" % link)
    if not link.exists():
        res = subprocess.run(["cmd", "/c", "mklink", "/J", str(link), str(target)], capture_output=True, text=True)
        if res.returncode:
            raise Fail("couldn't link %s: %s" % (link, (res.stderr or res.stdout).strip()))
    write_shims(bin_dir)
    if add_to_user_path(bin_dir):
        print("note: added %s to your user PATH; open a new terminal and restart VS Code to pick it up" % bin_dir)
    print("Coordinator installed: coord -> %s, /coordinate -> %s" % (bin_dir / "coord", link))


def cmd_update(a):
    if not (ROOT / ".git").exists():
        print("Coordinator is installed as a plugin here. Update it with:\n"
              "  claude plugin marketplace update coordinator && claude plugin update coordinator@coordinator")
        return
    before = coord_version()
    res = run(["git", "-C", ROOT, "pull", "--ff-only"], check=False)
    if res.returncode:
        raise Fail("couldn't update %s: %s" % (ROOT, (res.stderr or res.stdout).strip()[-300:]))
    subprocess.run(coord_argv() + ["_install"] if WINDOWS else [str(ROOT / "install.sh")], capture_output=True)
    after = coord_version()
    if after == before:
        print("Coordinator %s is up to date." % after)
    else:
        print("Updated Coordinator %s -> %s. Start a new Claude Code session to load the new /coordinate; running "
              "schedulers pick up the new code by themselves, without stopping their agents." % (before, after))
    ok, why = selftest(json.loads(json.dumps(DEFAULTS)))
    print(("selftest passed: %s" if ok else "selftest FAILED: %s - runs would not start; see `coord selftest`") % why)


def metrics_line(r, data):
    """One run's numbers, without the owner's words: what `coord stats` reads after the run's files are gone."""
    added = deleted = 0
    if data.get("branch") and data.get("mode") == "build":
        out = run(["git", "diff", "--shortstat", "%s...%s" % (data["base"], data["branch"])], cwd=r.project, check=False).stdout
        m_add, m_del = re.search(r"(\d+) insertion", out), re.search(r"(\d+) deletion", out)
        added, deleted = int(m_add.group(1)) if m_add else 0, int(m_del.group(1)) if m_del else 0
    notes = data.get("owner_notes") or []
    tasks = [{"id": t["id"], "type": t["type"], "role": role_of(t), "model": t.get("model") or r.cfg["models"].get(role_of(t), ""),
              "effort": t.get("effort") or r.cfg["efforts"].get(role_of(t), ""), "size": t.get("size"),
              "status": t["status"], "minutes": t.get("minutes", 0), "tokens": t.get("tokens", 0),
              "cost": t.get("cost", 0), "audit_rounds": t.get("audit_round", 0), "attempts": t.get("attempts", 0),
              "parent": t.get("parent", ""), "fix_kind": t.get("fix_kind", ""),
              "questions": len(t.get("qa") or []), "defaults": sum(1 for q in t.get("qa") or [] if q.get("by_default"))}
             for t in data["tasks"]]
    created = data.get("created")
    end = now()
    wall = (dt.datetime.fromisoformat(end) - dt.datetime.fromisoformat(created)).total_seconds() / 60 if created else 0
    return {"run": r.name, "version": data.get("version") or coord_version(), "mode": "quick" if data.get("quick") else
            data.get("mode"), "full_auto": bool(data.get("full_auto")), "created": created, "ended": end,
            "wall_minutes": round(wall, 1), "status": data.get("status"), "pr_url": data.get("pr_url", ""),
            "pr_merged": bool(data.get("pr_merged")), "lines_added": added, "lines_deleted": deleted,
            "owner": {"answers": sum(1 for n in notes if n["kind"] == "answer"),
                      "additions": sum(1 for n in notes if n["kind"] == "addition"),
                      "notes": sum(1 for n in notes if n["kind"] == "note"),
                      "defaults": sum(1 for n in notes if n["kind"] == "default")},
            "minutes": round(sum(t["minutes"] for t in tasks), 1), "tokens": sum(t["tokens"] for t in tasks),
            "cost": round(sum(t["cost"] for t in tasks), 4), "tasks": tasks, "gates": data.get("gates") or []}


def record_metrics(r, data):
    if data.get("metrics_recorded") or not data.get("tasks"):
        return
    line = metrics_line(r, data)
    store = r.project / STORE
    store.mkdir(exist_ok=True)
    with locked(store / ".metrics.lock"):
        with open(store / "metrics.jsonl", "a", encoding="utf-8") as f:
            f.write(json.dumps(line, ensure_ascii=False) + "\n")
    if r.tasks_file.exists():
        with r.edit() as d:
            d["metrics_recorded"] = now()


def print_stats(m):
    print("%s · %s%s · %s · %s wall, %s agent time · $%.2f · %s tokens · +%d/-%d lines%s" % (
        m["run"], m["mode"], ", full auto" if m.get("full_auto") else "", m["status"], human_minutes(m["wall_minutes"]),
        human_minutes(m["minutes"]), m["cost"], human_tokens(m["tokens"]), m["lines_added"], m["lines_deleted"],
        " · %s" % m["pr_url"] if m.get("pr_url") else ""))
    by_role = {}
    for t in m["tasks"]:
        x = by_role.setdefault(t["role"], [0, 0.0, 0.0])
        x[0] += 1
        x[1] += t["minutes"]
        x[2] += t["cost"]
    print("  by role: " + ", ".join("%s %d × %s $%.2f" % (k, v[0], human_minutes(v[1]), v[2]) for k, v in sorted(by_role.items())))
    for t in m["tasks"]:
        print("  %-10s %-8s %-7s %s/%s size %s · %s · $%.2f%s%s" % (
            t["id"], t["role"], t["status"], t["model"], t["effort"], t["size"], human_minutes(t["minutes"]), t["cost"],
            " · %d audit round(s)" % t["audit_rounds"] if t["audit_rounds"] else "",
            " · %d question(s), %d by default" % (t["questions"], t["defaults"]) if t["questions"] else ""))
    for g in m.get("gates") or []:
        print("  gate after %s: %s in %ds%s%s" % (g["task"], "pass" if g["ok"] else "FAIL", g["seconds"],
                                                  " (flaky)" if g.get("flaky") else "", " (known failure)" if g.get("known") else ""))
    o = m.get("owner") or {}
    print("  owner: %d answer(s), %d addition(s), %d note(s); %d question(s) settled by default" % (
        o.get("answers", 0), o.get("additions", 0), o.get("notes", 0), o.get("defaults", 0)))


def cmd_stats(a):
    project = project_root()
    lines = []
    f = project / STORE / "metrics.jsonl"
    if f.exists():
        for x in f.read_text(encoding="utf-8").splitlines():
            try:
                lines.append(json.loads(x))
            except ValueError:
                pass
    live = {r.name: metrics_line(r, r.load()) for r in list_runs(project) if not r.load().get("metrics_recorded")}
    pick = lambda name: next((m for m in reversed(lines) if m["run"] == name), None) or live.get(name)
    if a.all:
        for m in lines + list(live.values()):
            print_stats(m)
        return
    names = [a.run] if a.run else []
    if not names:
        latest = (lines[-1:] + list(live.values()))
        names = [max(latest, key=lambda m: m.get("ended") or "")["run"]] if latest else []
    if a.compare:
        names.append(a.compare)
    if not names:
        print("no runs recorded in this project yet")
        return
    for n in names:
        m = pick(n)
        if not m:
            raise Fail("no run named %s in %s or among the open runs" % (n, f))
        print_stats(m)


SELFTEST_PROMPT = "Reply with exactly the word READY and nothing else."


def selftest(cfg, cached=False):
    """Start one tiny agent the way runs start theirs (same flags, prompt on stdin, role prompt from a file, inline
    agents), then resume it. (ok, why). Cached per Claude Code version, so a CLI change is caught before a run."""
    ver = run(claude_argv(cfg) + ["--version"], check=False)
    version = (ver.stdout or ver.stderr).strip()[:80]
    cache = HOME / "selftest.json"
    seen = read_json(cache, {}) or {}
    if cached and seen.get("version") == version and seen.get("ok") and seen.get("coord") == coord_version():
        return True, "cached"
    with tempfile.TemporaryDirectory(prefix="coord-selftest-") as tmp:
        tmp = Path(tmp)
        role = tmp / "role.md"
        role.write_text("You are checking that Coordinator can start you. Follow the prompt exactly.\n")
        settings = tmp / "settings.json"
        write_json(settings, {"permissions": {"allow": ["Bash(coord:*)"], "deny": ["Bash(git push:*)"]}})
        agents = json.dumps({"coord-check": {"description": "A check agent.", "prompt": "Say OK.\nLine two & more.",
                                             "model": "haiku", "effort": "low"}}, separators=(",", ":"))
        sid = str(uuid.uuid4())
        base = claude_argv(cfg) + ["-p", "--model", "haiku", "--effort", "low", "--permission-mode", cfg["permission_mode"],
                                   "--settings", str(settings), "--output-format", "json", "-n", "coord-selftest",
                                   "--append-system-prompt-file", str(role), "--agents", agents]
        why = ""
        for step, cmd, prompt in (("start", base + ["--session-id", sid], SELFTEST_PROMPT),
                                  ("resume", base + ["--resume", sid], "Again: " + SELFTEST_PROMPT)):
            try:
                p = subprocess.run(argv(cmd), cwd=str(tmp), input=prompt, text=True, capture_output=True, timeout=180,
                                   env=dict(os.environ, COORD_ROLE="", COORD_RUN_DIR=""))
            except (OSError, subprocess.TimeoutExpired) as e:
                why = "%s: %s" % (step, e)
                break
            out = None
            try:
                out = json.loads(p.stdout)
            except ValueError:
                pass
            if p.returncode or not out or "READY" not in str(out.get("result", "")):
                why = "%s: exit %s; %s" % (step, p.returncode, ((p.stderr or "") + (p.stdout or "")).strip()[-400:])
                break
    ok = not why
    write_json(cache, {"version": version, "ok": ok, "why": why, "at": now(), "coord": coord_version()})
    return ok, why or "agents start and resume"


def cmd_selftest(a):
    cfg = load_config(project_root()) if run(["git", "rev-parse"], check=False).returncode == 0 else json.loads(json.dumps(DEFAULTS))
    ok, why = selftest(cfg)
    print(("selftest passed: %s" if ok else "selftest FAILED: %s") % why)
    return 0 if ok else 1


def cmd_list(a):
    runs = list_runs(project_root())
    if not runs:
        print("no coordinators in this project")
    for r in runs:
        print(summary(r.load(), r.alive("scheduler")))


def cmd_terminate(a):
    r = pick_run(a.run)
    with r.edit() as d:
        d["terminating"] = True
    st = r.state()
    kill_group(st.get("scheduler_pid"), start=st.get("scheduler_start", ""))
    for job in (st.get("agents") or {}).values():
        kill_group(job.get("pid"), start=job.get("start", ""))
    kill_group(st.get("viewer_pid"), start=st.get("viewer_start", ""))
    for pid in list(st.get("dev_pids") or []):
        kill_group(pid)
    data = r.load()
    if not data.get("metrics_recorded"):
        try:
            record_metrics(r, data)
        except Exception as e:
            print("could not record the run's metrics: %r" % e, file=sys.stderr)
    saved = []
    for t in data["tasks"]:
        wt = r.wt(t["id"])
        if t["type"] in WORK and wt.exists() and not t.get("merged"):
            git(wt, "add", "-A", check=False)
            diff = run(["git", "diff", "--cached", "--binary", data["branch"]], cwd=wt, check=False).stdout
            if diff.strip():
                (r.task_dir(t["id"]) / "wip.patch").write_text(diff)
                saved.append(t["id"])
    wts = r.brain / "wt"
    if wts.exists():
        for wt in wts.iterdir():
            run(["git", "worktree", "remove", "--force", wt], cwd=r.project, check=False)
    run(["git", "worktree", "prune"], cwd=r.project, check=False)
    for br in git(r.project, "branch", "--list", "coord-tasks/%s/*" % r.name, check=False).splitlines():
        git(r.project, "branch", "-D", br.strip(" *+"), check=False)
    shutil.rmtree(r.brain, ignore_errors=True)
    with r.edit() as d:
        d.pop("terminating", None)
        for t in d["tasks"]:
            if t["status"] in ("in_progress", "review", "audit"):
                t["status"] = "paused"
        d["status"] = "finished" if all(t["status"] in ("done", "skipped") for t in d["tasks"]) else "paused"
        d["terminated"] = now()
        data = d
    # Saved work (now or by an earlier terminate) lives in the task folders: keep them unless --purge
    keep = [t["id"] for t in data["tasks"] if nonempty(r.task_dir(t["id"]) / "wip.patch")]
    left = remove_tree(r.dir) if a.purge or not keep else None
    removed = "its worktrees, task branches, internal files and task files" if left == [] else \
        "its worktrees, task branches and internal files"
    lines = ["terminated %s - stopped its agents and live page, removed %s." % (r.name, removed)]
    for t in data["tasks"]:
        lines.append("  %s %s - %s, %s, %s tokens" % (t["id"], t["title"], t["status"], human_minutes(t.get("minutes")),
                                                     human_tokens(t.get("tokens"))))
    if data.get("branch") and git(r.project, "branch", "--list", data["branch"], check=False):
        lines.append("Kept: the run branch %s." % data["branch"])
    if saved and left is not None:
        lines.append("Unfinished work in %s was deleted with the task files (--purge)." % ", ".join(saved))
    elif saved:
        lines.append("Unfinished work saved as wip.patch in: %s" % ", ".join(saved))
    if left is None:
        lines.append("Kept the task files in %s: they hold unfinished work (wip.patch in %s). "
                     "`coord terminate %s --purge` deletes them." % (r.dir, ", ".join(keep), r.name))
    elif left:
        lines.append("Could not remove %d file(s) from %s: %s%s" % (len(left), r.dir, ", ".join(left[:10]),
                                                                   " and more" if len(left) > 10 else ""))
    write_catalog(r.project)
    print("\n".join(lines))


def merge_pr(p):
    """Merge one pull request as a single squashed commit: its title, no body. Returns the step's result."""
    view = run(["gh", "pr", "view", p["url"], "--json", "state,isDraft,title"], cwd=p["repo"], check=False)
    if view.returncode:
        raise Fail((view.stderr or view.stdout).strip()[-300:] or "gh pr view failed")
    pr = json.loads(view.stdout)
    if pr.get("state") == "MERGED":
        return "already merged"
    if pr.get("state") == "CLOSED":
        raise Fail("the pull request is closed")
    if pr.get("isDraft"):
        run(["gh", "pr", "ready", p["url"]], cwd=p["repo"])
    run(["gh", "pr", "merge", p["url"], "--squash", "--subject", pr.get("title") or p["run"], "--body", ""], cwd=p["repo"])
    return "merged"


def cmd_merge(a):
    r = pick_run(a.run)
    try:
        merge_all(r)
    except Exception as e:
        # Started from the live page, the record says "merging" before these checks run: leave the reason there
        error = str(e).strip() or repr(e)
        if r.tasks_file.exists():  # its terminate may have deleted the run's folder already
            with r.edit() as d:
                m = d.get("merge") or {}
                if m.get("status") == "merging" and m.get("pid") == os.getpid():
                    m.update(status="failed", error=error)
        raise e if isinstance(e, Fail) else Fail(error)


def merge_all(r):
    data = r.load()
    if data.get("parent"):
        top = first_run(data)
        raise Fail("%s is a follow-up run; merge all from its first run: `coord merge %s` in %s" % (r.name, top["run"], top["repo"]))
    prs = pull_requests(r, data)
    waiting = [p for p in prs if p["status"] != "finished" or not p["url"]]
    if waiting:
        raise Fail("every run must be finished with a pull request first; not yet: %s" % ", ".join(
            "%s in %s (%s)" % (p["run"], p["repo_name"], p["status"] if p["status"] != "finished" else "no pull request")
            for p in waiting))
    if not shutil.which("gh"):
        raise Fail("gh is not on PATH")
    with r.edit() as d:
        m = d.get("merge") or {}
        if m.get("status") == "merging" and m.get("pid") != os.getpid() and alive(m.get("pid")):
            raise Fail("a merge is already running (pid %s)" % m["pid"])
        d["merge"] = {"status": "merging", "pid": os.getpid(), "error": "", "steps": []}
    lines = []
    for p in prs:
        try:
            result = merge_pr(p)
        except Exception as e:
            error = str(e)
            with r.edit() as d:
                d["merge"]["steps"].append(dict(run=p["run"], repo_name=p["repo_name"], url=p["url"], result="failed: " + error))
                d["merge"].update(status="failed", error=error)
            print("\n".join(lines + ["failed · %s · %s · %s" % (p["repo_name"], p["run"], p["url"])]))
            raise Fail("merging %s failed, nothing was ended; fix it and run `coord merge %s` again: %s" % (p["url"], r.name, error))
        if not p["merged"]:
            with Run(p["repo"], p["run"]).edit() as d:
                d["pr_merged"] = now()
        with r.edit() as d:
            d["merge"]["steps"].append(dict(run=p["run"], repo_name=p["repo_name"], url=p["url"], result=result))
        lines.append("%s · %s · %s · %s" % (result, p["repo_name"], p["run"], p["url"]))
    with r.edit() as d:
        d["merge"]["status"] = "done"
    print("\n".join(lines))
    # Deepest first, the first run last: ending it stops its live page, and its worktree may hold this very file
    failed = []
    for p in reversed(prs):
        try:
            res = subprocess.run(coord_argv() + ["terminate", p["run"]], cwd=p["repo"],
                                 env=other_repo_env(), text=True, capture_output=True, stdin=subprocess.DEVNULL, timeout=300)
        except subprocess.TimeoutExpired:
            failed.append(p["run"])
            print("terminate %s in %s timed out" % (p["run"], p["repo_name"]))
            continue
        print((res.stdout or "").strip() or "terminate %s in %s printed nothing" % (p["run"], p["repo_name"]))
        if res.returncode:
            failed.append(p["run"])
            print((res.stderr or "").strip(), file=sys.stderr)
    if failed:
        raise Fail("all pull requests are merged, but these runs did not end: %s; run `coord terminate <run>` in their repos"
                   % ", ".join(failed))


def start_merge(r):
    """The live page's Approve: `coord merge` in its own session, so it outlives this page's server."""
    with r.edit() as d:
        ready, waiting_for = merge_ready(r, d)
        if (d.get("merge") or {}).get("status") == "merging" and alive(d["merge"].get("pid")):
            raise Fail("a merge is already running")
        if not ready:
            raise Fail("not ready to merge all" + (": waiting for %s" % ", ".join(waiting_for) if waiting_for else ""))
        if not shutil.which("gh"):
            raise Fail("gh is not on PATH")
        (r.brain / "logs").mkdir(parents=True, exist_ok=True)
        with open(r.brain / "logs" / "merge.out", "a") as log:
            p = spawn(coord_argv() + ["merge", r.name], cwd=str(r.project),
                      env=other_repo_env(), stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
        d["merge"] = {"status": "merging", "pid": p.pid, "error": "", "steps": []}


# ---------------------------------------------------------------- agent commands

def owner_only(a):
    """True when an agent runs an owner's command on its own run or that run's family (its first run, every follow-up)."""
    rd = os.environ.get("COORD_RUN_DIR")
    if not os.environ.get("COORD_ROLE") or not rd or a.cmd in AGENT_CMDS or (a.cmd == "todo" and a.action != "done"):
        return False
    if a.cmd in ("update", "_install"):
        return True
    mine = Run(Path(rd).parent.parent, Path(rd).name)
    try:
        if a.cmd in ("start", "map"):
            return Path(project_root()).resolve() == mine.project
        target = pick_run(getattr(a, "run", None))
        if target.dir == mine.dir:
            return True
        def top(x):
            t = first_run(x.load())
            return Run(t["repo"], t["run"]) if t else x
        root = top(mine)
        return top(target).dir == root.dir or \
            (str(target.project), target.name) in {(p["repo"], p["run"]) for p in pull_requests(root, root.load())}
    except Fail:
        return False  # no such run: the command itself says so


def agent_ctx():
    rd, tid = os.environ.get("COORD_RUN_DIR"), os.environ.get("COORD_TASK")
    if not rd or not tid:
        raise Fail("`coord task` and `coord audit` are for agents started by the coordinator")
    p = Path(rd)
    return Run(p.parent.parent, p.name), tid, os.environ.get("COORD_ROLE", "")


def cmd_task(a):
    r, tid, role = agent_ctx()
    act = a.action
    if act == "show":
        t = find(r.load(), tid)
        print(json.dumps(t, indent=2))
        print("files: %s" % ", ".join(str(r.task_dir(tid) / f) for f in TASK_FILES))
        return
    if act == "list":
        for t in r.load()["tasks"]:
            print("%s [%s/%s] %s | after: %s | files: %s | %s/%s, size %s | tests %s | ui %s" % (
                t["id"], t["type"], t["status"], t["title"], ",".join(t["depends_on"]) or "-",
                ",".join(t["files"]) or "-", t.get("model") or "default", t.get("effort") or "default", t["size"],
                "on" if t.get("tests") else "off", "on" if t.get("ui") else "off")
                  + (" | external: %s" % ",".join(t["external"]) if t.get("external") else ""))
        data = r.load()
        print("design language: %s" % design_line(data))
        for f in data.get("followups") or []:
            print("follow-up %s: %s | %s" % (f.get("run") or f["name"], followup_line(data, f), f["note"]))
        return
    if act in ("add", "edit", "remove", "design", "followup") and role != "planner":
        raise Fail("only the planner adds, edits or removes tasks and records the design language and follow-up runs")
    msg, nudge = "", ""
    repo = followup_repo(r, a.repo or "") if act == "followup" else None
    with r.edit() as d:
        if act == "followup":
            note, fus = " ".join(a.text).strip(), d.setdefault("followups", [])
            i = next((i for i, f in enumerate(fus) if f["repo"] == str(repo)), None)
            if i is not None and (fus[i].get("status") == "started" or fus[i].get("run")):
                raise Fail("the follow-up run for %s has started (%s); put any change for it under \"Not in this run\""
                           % (repo, fus[i].get("run") or fus[i]["name"]))
            if not note:
                if i is not None:
                    del fus[i]
                msg = "removed the follow-up for %s" % repo if i is not None else "no follow-up recorded for %s" % repo
            else:
                f = {"repo": str(repo), "note": note, "name": slug("%s-%s" % (d["name"], slug(repo.name))),
                     "status": "pending", "run": "", "url": "", "error": ""}
                if i is None:
                    fus.append(f)
                else:
                    fus[i] = f
                msg = "follow-up run %s recorded for %s; %s" % (f["name"], repo, "coord starts it when the owner approves"
                                                               if d.get("mode") == "build" else "a plan-only run doesn't start it")
        elif act == "add":
            known = {t["id"] for t in d["tasks"]}
            deps = [x.strip() for x in (a.deps or "").split(",") if x.strip()]
            missing = [x for x in deps if x not in known]
            if missing:
                raise Fail("unknown dependencies: %s" % ", ".join(missing))
            new = new_task(a.id or next_id(d), a.title, "build", deps, [x.strip() for x in (a.files or "").split(",") if x.strip()],
                           a.size or "M", a.model or "", a.effort or "")
            new["tests"] = a.tests == "on"
            new["external"] = [str(Path(x.strip()).expanduser()) for x in (a.external or "").split(",") if x.strip()]
            new["ui"] = a.ui == "on"
            if new["id"] in known:
                raise Fail("%s exists" % new["id"])
            if d.get("plan_approved") and d.get("mode") == "build":
                new["pending_approval"] = True  # an addition while the run builds: it waits for the owner's approval
            d["tasks"].append(new)
            r.task_dir(new["id"]).mkdir(parents=True, exist_ok=True)
            msg = "added %s - now write its brief to %s" % (new["id"], r.task_dir(new["id"]) / "knowledge.md")
        elif act == "design":
            if a.target not in ("project", "impeccable", "other"):
                raise Fail("say which: coord task design project|impeccable|other --source \"...\"")
            d["design"] = {"choice": a.target, "source": a.source or ""}
            msg = "design language recorded: %s" % design_line(d)
        elif act in ("edit", "remove"):
            t = find(d, a.target)
            if t["status"] not in ("queue",) or t["type"] != "build":
                raise Fail("only queued build tasks can change")
            if act == "remove":
                t["status"] = "skipped"
                msg = "removed %s" % a.target
            else:
                for field in ("title", "size", "model", "effort"):
                    if getattr(a, field):
                        t[field] = getattr(a, field)
                if a.tests:
                    t["tests"] = a.tests == "on"
                if a.ui:
                    t["ui"] = a.ui == "on"
                if a.deps is not None:
                    t["depends_on"] = [x.strip() for x in a.deps.split(",") if x.strip()]
                if a.files is not None:
                    t["files"] = [x.strip() for x in a.files.split(",") if x.strip()]
                if a.external is not None:
                    t["external"] = [str(Path(x.strip()).expanduser()) for x in a.external.split(",") if x.strip()]
                msg = "updated %s" % a.target
        else:
            t = find(d, tid)
            if act == "start":
                t["status"] = "in_progress"
                msg = "started"
            elif act == "review":
                t["status"] = "review"
                msg = "in review"
            elif act == "done":
                if t["type"] in WORK and not nonempty(r.task_dir(tid) / "changes.md"):
                    raise Fail("write %s first" % (r.task_dir(tid) / "changes.md"))
                if t["type"] == "pr" and not nonempty(r.dir / "pr.md"):
                    raise Fail("write %s first" % (r.dir / "pr.md"))
                if t["type"] == "map" and not nonempty(r.project / STORE / "map" / "AGENTS.md"):
                    raise Fail("write %s first" % (r.project / STORE / "map" / "AGENTS.md"))
                if t["type"] == "plan":
                    if not nonempty(r.dir / "plan.md"):
                        raise Fail("write %s first" % (r.dir / "plan.md"))
                    empty = [x["id"] for x in d["tasks"] if x["type"] in WORK and x["status"] == "queue"
                             and not nonempty(r.task_dir(x["id"]) / "knowledge.md")]
                    if empty:
                        raise Fail("these tasks have no knowledge.md yet: %s" % ", ".join(empty))
                    n, depth = critical_path(d)
                    width = -(-n // max(1, int(r.cfg["max_parallel"]))) + 1
                    if n >= 3 and depth > width and not t.get("width_checked"):
                        t["width_checked"] = True  # saved, then refused below: the planner is asked once
                        nudge = ("%d of your %d tasks run one after another. If some could run side by side, split "
                                 "by file or area instead of by step (against an agreed contract, with one task to "
                                 "join them), and set --deps only where a task needs another's result. If the chain "
                                 "is needed, say why in one line under \"Approach\". Then run `coord task done` "
                                 "again." % (depth, n))
                officer = r.cfg["officer"]
                if t["type"] == "plan":
                    check = officer_on_plan(r.cfg, d) and not t.get("audit_final") and t["audit_round"] < int(
                        officer.get("max_rounds", 1))
                elif t["type"] == "map":
                    check = officer.get("plan") not in (False, "never") and t["audit_round"] < int(officer.get("max_rounds", 1))
                else:
                    check = officer.get("tasks") and t["type"] == "build" and not t.get("parent") and not d.get("quick")
                if not nudge:
                    t["status"] = "audit" if check else "done"
                    t["finished"] = now()
                msg = "done - the hallucination officer checks it next. End your turn now." if check else "done. End your turn now."
            elif act == "ask":
                if not a.default and not a.no_default:
                    raise Fail("give your recommended answer with --default \"...\": the run goes on with it if the "
                               "owner doesn't answer in time. Only a question with no safe default (a secret, an "
                               "account, a payment) takes --no-default, and then it waits for the owner.")
                t.update(status="waiting_on_you", question=" ".join(a.text), question_kind="agent",
                         question_default=(a.default or "").strip(), question_at=now())
                minutes = 3 if d.get("full_auto") else r.cfg.get("question_minutes")
                msg = ("question recorded; if the owner doesn't answer within %s minutes, you go on with your default. "
                       "End your turn now; you are resumed with the answer." % minutes) if a.default else \
                    "question recorded. End your turn now; you are resumed with the answer."
            elif act == "intent":
                t["intent"] = " ".join(a.text).strip()
                msg = "intent recorded; the owner sees it on the live page. Carry on."
            elif act == "rest":
                t["rest"] = " ".join(a.text).strip()
                msg = "recorded; it becomes a follow-on task once this one merges. Finish this one now."
            elif act == "note":
                (r.task_dir(tid) / "resume.md").write_text("# Resume note (%s)\n\n%s\n" % (now()[:16], " ".join(a.text)))
                t["status"] = "paused"
                msg = "note saved. End your turn now."
            elif act == "todo":
                todos = d.setdefault("todos", [])
                words = " ".join(a.text).split()
                if words in (["list"], ["show"]):
                    msg = "\n".join("%d. [%s] %s" % (x["n"], "done" if x.get("done") else "to do", x["text"])
                                    for x in todos) or "no manual steps recorded"
                elif len(words) < 4:
                    raise Fail("say what the owner must do and why, in a sentence")
                else:
                    n = max([x["n"] for x in todos] or [0]) + 1
                    todos.append({"n": n, "task": tid, "text": " ".join(a.text), "at": now(), "done": False})
                    msg = "recorded for the owner (step %d). Carry on with your work." % n
    if nudge:
        raise Fail(nudge)
    r.poke()
    if act == "ask":
        notify("coord · %s" % r.name, "%s asks: %s" % (tid, " ".join(a.text))[:200])
    if act == "todo" and msg.startswith("recorded"):
        notify("coord · %s" % r.name, "%s: for you to do: %s" % (tid, " ".join(a.text))[:200])
    print(msg)


def cmd_audit(a):
    r, tid, role = agent_ctx()
    if role != "officer":
        raise Fail("only the hallucination officer records a verdict")
    if not nonempty(a.file):
        raise Fail("write your report first: %s" % a.file)
    with r.edit() as d:
        t = find(d, tid)
        t["audit_verdict"], t["audit_file"] = a.verdict, str(Path(a.file).resolve())
        if a.verdict == "notes":
            t["audit_notes"] = str(Path(a.file).resolve())
    r.poke()
    print("verdict recorded: %s. End your turn now." % a.verdict)


def under(path, folder):
    """True when path is folder or inside it, ignoring case where the file system does (Windows)."""
    p, f = os.path.normcase(path), os.path.normcase(os.path.realpath(folder))
    return p == f or p.startswith(f.rstrip(os.sep) + os.sep)


def cmd_hook(a):
    try:
        inp = json.load(sys.stdin)
    except ValueError:
        return 0
    rd = os.environ.get("COORD_RUN_DIR")
    if not rd:
        return 0
    tool, ti = inp.get("tool_name", ""), inp.get("tool_input") or {}
    cmd = ti.get("command", "") if tool == "Bash" else ""
    if re.search(r"/api/(approve|accept|answer|pause|resume|todo|merge|auto|say)\b", cmd):
        # The run's own live page takes the owner's clicks, not an agent's requests
        port = Run(Path(rd).parent.parent, Path(rd).name).state().get("viewer_port")
        if port and re.search(r"(127\.0\.0\.1|localhost|0\.0\.0\.0):%s\b" % port, cmd):
            sys.stderr.write(OWNER_ONLY + "\n")
            return 2
    if tool == "Bash" and re.match(r"\s*(\S*/)?coord\s", cmd + " "):
        return 0
    data = read_json(Path(rd) / "tasks.json", {}) or {}
    if data.get("status") == "paused" or data.get("terminating"):
        sys.stderr.write('The run is paused. Write your exact next step with `coord task note "<next step>"`, then end your turn.\n')
        return 2
    tid, role = os.environ.get("COORD_TASK", ""), os.environ.get("COORD_ROLE", "")
    t = next((x for x in data.get("tasks", []) if x["id"] == tid), None)
    if t and t.get("status") == "waiting_on_you":
        sys.stderr.write("Your question waits for the owner's answer. End your turn now; you are resumed with the answer.\n")
        return 2
    if t and t.get("inbox") and role in ("builder", "planner"):
        r = Run(Path(rd).parent.parent, Path(rd).name)
        with r.edit() as d:
            msgs = find(d, tid)["inbox"]
            find(d, tid)["inbox"] = []
        sys.stderr.write("Message from the owner, delivered by the coordinator:\n%s\nTake it into account, then repeat "
                         "your last tool call if it is still right.\n" % "\n".join("- " + m for m in msgs))
        return 2
    path = ti.get("file_path") or ti.get("notebook_path")
    wt = os.environ.get("COORD_WT", "")
    if tool == "Read" and path and role in ("planner", "builder"):
        real = os.path.realpath(os.path.expanduser(path))
        try:
            size = os.path.getsize(real)
        except OSError:
            size = 0
        if real.endswith(".jsonl") and under(real, str(TRANSCRIPTS)):
            sys.stderr.write("Blocked: transcripts are too big to read here. Hand them to `coord-briefer` (Agent tool, "
                             "subagent_type coord-briefer) with your question and a brief path in your task folder.\n")
            return 2
        if size > (256 << 10) and not (ti.get("limit") and int(ti.get("limit") or 0) <= 600):
            sys.stderr.write("Blocked: %s is %d KB. Read the part you need (offset and limit of at most 600 lines), "
                             "find it with Grep, or hand the file to `coord-briefer` with your question.\n"
                             % (path, size >> 10))
            return 2
    if tool in ("Edit", "Write", "NotebookEdit", "MultiEdit") and path and role == "builder" and t and not t.get("tests") and wt:
        real = os.path.realpath(os.path.expanduser(path))
        if under(real, wt):
            cfg = load_config(Path(rd).parent.parent)
            rel = os.path.relpath(real, os.path.realpath(wt))
            if is_test_file(cfg, rel):
                # A change can break an existing test only through a type or a name it uses: a small edit is allowed
                lines = test_edit_lines(real, tool, ti) if os.path.isfile(real) and tool != "NotebookEdit" else None
                ledger = Path(rd) / "tasks" / tid / "test-edits.json"
                used = read_json(ledger, {}) or {}
                if lines is not None and used.get(rel, 0) + lines <= 8:
                    used[rel] = used.get(rel, 0) + lines
                    ledger.parent.mkdir(parents=True, exist_ok=True)
                    write_json(ledger, used)
                    return 0
                sys.stderr.write("Blocked: tests are OFF for this task - the owner didn't ask for them. You may only make "
                                 "small edits (up to 8 lines per file in all, no new test cases or files) that a type, "
                                 "name or signature change forces on an existing test; list them under \"Forced test "
                                 "edits\" in changes.md. Anything bigger: ask with `coord task ask ... --default`.\n")
                return 2
    if tool in ("Edit", "Write", "NotebookEdit", "MultiEdit") and path:
        real = os.path.realpath(os.path.expanduser(path))
        if os.path.normcase(real) == os.path.normcase(os.path.realpath(os.path.join(rd, "tasks.json"))):
            sys.stderr.write("Blocked: only `coord` writes tasks.json; change your own task with `coord task`.\n")
            return 2
        inside = lambda x: under(real, x)
        allowed = [rd] + ([str(Path(rd).parent)] if role in ("planner", "mapper") else []) + ([wt] if role == "builder" and wt else [])
        if role == "builder" and t:
            allowed += list(t.get("external") or [])
        temps = [tempfile.gettempdir(), "/tmp", "/private/tmp"]
        in_project = inside(os.environ.get("COORD_PROJECT") or str(Path(rd).parent.parent))
        if not any(inside(x) for x in allowed) and (in_project or not any(inside(x) for x in temps)):
            sys.stderr.write("Blocked: the %s may only write inside %s.\n" % (role, " or ".join(allowed)))
            return 2
    return 0


# ---------------------------------------------------------------- live page

TRANSCRIPTS = Path.home() / ".claude" / "projects"
REMINDER_RE = re.compile(r"<system-reminder>.*?</system-reminder>", re.S)
TOOL_ARGS = ("file_path", "notebook_path", "command", "pattern", "url", "query", "skill", "description", "prompt")
PATH_ARGS = ("file_path", "notebook_path")


def task_sessions(t):
    # A task's agent sessions in order: its planner or builder, then each officer audit.
    out = [{"session": t["session"], "role": role_of(t)}] if t.get("session") else []
    return out + [{"session": a["session"], "role": "officer", "round": a["round"]} for a in t.get("audit_sessions", [])]


def transcript(sid):
    # Found by session id only, and only under ~/.claude/projects/.
    base = TRANSCRIPTS.resolve()
    for p in base.glob("*/%s.jsonl" % sid):
        p = p.resolve()
        if base in p.parents and p.is_file():
            return p
    return None


def subagents(main):
    # The subagents (reviewers) a session spawned, oldest first, named from the .meta.json beside each.
    def born(p):
        try:
            st = p.stat()
        except OSError:
            return 0
        return getattr(st, "st_birthtime", st.st_mtime)
    out = []
    for p in sorted((main.parent / main.stem / "subagents").glob("agent-*.jsonl"), key=born):
        meta = read_json(p.with_suffix(".meta.json"), {}) or {}
        out.append({"agent": p.stem, "type": str(meta.get("agentType", ""))[:80],
                    "description": str(meta.get("description", ""))[:120]})
    return out


def _clip(s, n):
    return s if len(s) <= n else s[:n] + "…"


def conversation_entries(line):
    # What the live page shows of one transcript line: the agent's text, tool calls, tool results and the prompts
    # it was given. Everything else (system prompts, API requests, attachments, thinking) is dropped.
    if b'"type":"user"' not in line and b'"type":"assistant"' not in line:
        return []
    try:
        d = json.loads(line)
    except ValueError:
        return []
    if not isinstance(d, dict) or d.get("type") not in ("user", "assistant") or d.get("isMeta") \
            or d.get("isCompactSummary"):
        return []
    who = d["type"]
    msg = d.get("message")
    content = msg.get("content") if isinstance(msg, dict) else None
    if isinstance(content, str):
        content = [{"type": "text", "text": content}]
    out = []
    for b in content if isinstance(content, list) else []:
        kind = b.get("type") if isinstance(b, dict) else None
        if kind == "text" and isinstance(b.get("text"), str):
            text = REMINDER_RE.sub("", b["text"]).strip()
            if text:
                out.append({"k": "text" if who == "assistant" else "prompt", "text": _clip(text, 20000)})
        elif kind == "tool_use" and who == "assistant":
            inp = b.get("input") if isinstance(b.get("input"), dict) else {}
            key = next((k for k in TOOL_ARGS if isinstance(inp.get(k), str)), None) or \
                next((k for k, v in inp.items() if isinstance(v, str)), None)
            e = {"k": "tool", "id": str(b.get("id", ""))[:100], "name": str(b.get("name", ""))[:80],
                 "arg": _clip(inp[key], 600) if key else ""}
            if key in PATH_ARGS:
                e["path"] = inp[key][:4096]
            out.append(e)
        elif kind == "tool_result" and who == "user":
            c = b.get("content")
            parts = [{"type": "text", "text": c}] if isinstance(c, str) else [x for x in c if isinstance(x, dict)] if isinstance(c, list) else []
            text = REMINDER_RE.sub("", "\n".join(str(x.get("text", "")) for x in parts if x.get("type") == "text")).strip()
            e = {"k": "result", "for": str(b.get("tool_use_id", ""))[:100], "text": _clip(text, 8000),
                 "error": bool(b.get("is_error"))}
            images = sum(1 for x in parts if x.get("type") == "image")
            if images:
                e["images"] = images
            out.append(e)
    return out


def read_conversation(path, offset, raw_cap=16 << 20, out_cap=256 << 10):
    # Whole lines from a byte offset; a line still being written waits for the next poll. Capped both ways.
    entries, used, reset = [], 0, False
    with open(str(path), "rb") as f:
        end = f.seek(0, 2)
        if offset > end:
            offset, reset = 0, True
        start = offset
        f.seek(offset)
        while offset < end and used < out_cap and offset - start < raw_cap:
            line = f.readline()
            if not line.endswith(b"\n"):
                break
            offset += len(line)
            got = conversation_entries(line)
            entries += got
            used += sum(len(json.dumps(e)) for e in got)
    more = offset < end and (used >= out_cap or offset - start >= raw_cap)
    return {"entries": entries, "next": offset, "more": more, "reset": reset}


VIEW_IMAGES = {".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".gif": "image/gif",
               ".webp": "image/webp", ".avif": "image/avif", ".bmp": "image/bmp", ".ico": "image/x-icon",
               ".svg": "image/svg+xml"}
VIEW_CAPS = {"image": 25 << 20, "text": 2 << 20}


def folder_files(base, skip=()):
    # Every file in a folder, hidden ones too, as {name, size, mtime}. `skip` holds folders (relative paths) that are
    # listed on their own.
    out = []
    for d, dirs, names in os.walk(str(base)):
        rel = Path(d).relative_to(base)
        dirs[:] = sorted(x for x in dirs if (rel / x).as_posix() not in skip)
        for n in sorted(names):
            p = Path(d) / n
            try:
                st = p.lstat()
            except OSError:
                continue
            out.append({"name": p.relative_to(base).as_posix(), "size": st.st_size, "mtime": int(st.st_mtime * 1000)})
    return out


def raw_type(p):
    # The type a file is served with when opened in its own tab. Text without a type of its own shows as plain text;
    # a file that can run script gets a sandbox (an opaque origin, so it can't use this page's API).
    t = mimetypes.guess_type(p.name)[0]
    if t is None or (t.startswith("text/") and t not in ("text/html", "text/css", "text/javascript")):
        with open(str(p), "rb") as f:
            t = "application/octet-stream" if b"\0" in f.read(8192) else "text/plain; charset=utf-8"
    scripted = t in ("text/html", "application/xhtml+xml", "image/svg+xml") or t.endswith("/xml")
    return t, scripted


def reveal(p):
    # Show the file in Finder (selected), or open its folder elsewhere.
    if WINDOWS:
        subprocess.Popen(["explorer", "/select,", str(p)])
        return
    cmd = ["open", "-R", str(p)] if sys.platform == "darwin" else ["xdg-open", str(p.parent)]
    if shutil.which(cmd[0]):
        spawn(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def view_path(r, raw, tid="", folder=False):
    # A file the live page may show: under the project, the run's worktrees or the run folder once symlinks are
    # resolved. No "~", no "..". A relative path is looked up in the task's folder, or the run folder without a task
    # (`folder`); otherwise in the task's worktree, the project, then the task's (or run's) folder, so a note that
    # names its own screenshot opens it. None when refused or missing.
    if not raw or len(raw) > 4096 or "\0" in raw or raw.startswith("~") or ".." in Path(raw).parts \
            or (tid and not re.fullmatch(r"[A-Za-z0-9_-]+", tid)):
        return None
    p = Path(raw)
    own = r.task_dir(tid) if tid else r.dir
    if folder:
        if p.is_absolute():
            return None
        cands = [own / p]
    else:
        cands = [p] if p.is_absolute() else ([r.wt(tid) / p] if tid else []) + [r.project / p, own / p]
    roots = [x.resolve() for x in (r.project, r.brain / "wt", r.dir)]
    for c in cands:
        try:
            real = c.resolve()
        except (OSError, RuntimeError):
            continue
        if any(x in real.parents for x in roots) and real.is_file():
            return real
    return None


def view_kind(p):
    if p.suffix.lower() in VIEW_IMAGES:
        return "image"
    with open(str(p), "rb") as f:
        head = f.read(8192)
    return "binary" if b"\0" in head else "markdown" if p.suffix.lower() == ".md" else "text"


def view_state(r):
    data = r.load()
    st = r.state()
    for t in data["tasks"]:
        kd = r.task_dir(t["id"])
        t["files_present"] = [f for f in TASK_FILES if nonempty(kd / f)] + sorted(p.name for p in kd.glob("audit-*.md"))
        t["folder"] = folder_files(kd)
        t["sessions"] = task_sessions(t)
    data["plan_present"] = nonempty(r.dir / "plan.md")
    data["plan_audits"] = sorted(p.name for p in r.dir.glob("plan-audit-*.md"))
    # The run folder's own files (the plan, its audits, follow-up requests, the task store...); each task's folder is
    # listed with its task
    data["folder"] = folder_files(r.dir, skip={"tasks/%s" % t["id"] for t in data["tasks"]})
    data["dir"] = str(r.dir.resolve())
    data["platform"] = sys.platform
    data["scheduler_alive"] = r.alive("scheduler")
    data["agents"] = st.get("agents") or {}
    data["prs"] = pull_requests(r, data)
    data["waiting"] = owner_actions(r, data, data["scheduler_alive"])
    data["summary"] = summary(data, data["scheduler_alive"])
    n, depth = critical_path(data)
    data["shape"] = {"tasks": n, "parallel": min(n, int(r.cfg["max_parallel"])), "chain": depth}
    data["overlaps"] = run_overlaps(r, data) if not data.get("plan_approved") else []
    data["cost"] = round(sum(t.get("cost", 0) for t in data["tasks"]), 2)
    data["now"] = now()
    data["project"] = r.project.name
    return data


def cmd_viewer(a):
    r = Run(a.project, a.run)
    pref = 7400 + int(hashlib.sha1(str(r.dir).encode()).hexdigest(), 16) % 500
    port = free_port(pref)
    origin = "http://127.0.0.1:%d" % port
    hosts = ("127.0.0.1:%d" % port, "localhost:%d" % port)
    found = {}  # session id -> transcript path

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def send(self, code, body, ctype="application/json"):
            body = body if isinstance(body, bytes) else body.encode()
            self.send_response(code)
            self.send_header("Content-Type", ctype + "; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def send_file(self, p, cache):
            try:
                size = p.stat().st_size
                ctype, scripted = raw_type(p)
            except OSError:
                return self.send(404, json.dumps({"error": "not a file of this run"}))
            start, end = 0, size - 1
            m = re.fullmatch(r"bytes=(\d*)-(\d*)", self.headers.get("Range") or "")
            if m and (m.group(1) or m.group(2)):
                if m.group(1):
                    start, end = int(m.group(1)), min(int(m.group(2) or size - 1), size - 1)
                else:
                    start = max(size - int(m.group(2)), 0)
                if start > end:
                    self.send_response(416)
                    self.send_header("Content-Range", "bytes */%d" % size)
                    return self.end_headers()
                self.send_response(206)
                self.send_header("Content-Range", "bytes %d-%d/%d" % (start, end, size))
            else:
                self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(max(end - start + 1, 0)))
            self.send_header("Accept-Ranges", "bytes")
            self.send_header("Cache-Control", "private, max-age=3600" if cache else "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            if scripted:
                self.send_header("Content-Security-Policy", "sandbox allow-scripts allow-popups allow-forms allow-modals")
            self.end_headers()
            try:
                with open(str(p), "rb") as f:
                    f.seek(start)
                    left = end - start + 1
                    while left > 0:
                        chunk = f.read(min(left, 1 << 20))
                        if not chunk:
                            break
                        self.wfile.write(chunk)
                        left -= len(chunk)
            except (BrokenPipeError, ConnectionResetError):
                pass  # a video seeking elsewhere drops its earlier request

        def do_GET(self):
            u = urlparse(self.path)
            q = parse_qs(u.query)
            if u.path in ("/", "/index.html"):
                return self.send(200, (ROOT / "viewer" / "index.html").read_bytes(), "text/html")
            if u.path.startswith("/assets/"):
                # Brand files only: read-only, inside assets/, known types.
                types = {".svg": "image/svg+xml", ".woff2": "font/woff2", ".css": "text/css; charset=utf-8"}
                base = (ROOT / "assets").resolve()
                p = (base / u.path[len("/assets/"):]).resolve()
                if not re.match(r"^/assets/(fonts/)?[A-Za-z0-9_-]+(\.[A-Za-z0-9]+)+$", u.path) or base not in p.parents \
                        or p.suffix not in types or not p.is_file():
                    return self.send(404, "{}")
                body = p.read_bytes()
                self.send_response(200)
                self.send_header("Content-Type", types[p.suffix])
                self.send_header("Content-Length", str(len(body)))
                self.send_header("Cache-Control", "no-cache")
                self.end_headers()
                return self.wfile.write(body)
            if u.path == "/api/state":
                try:
                    return self.send(200, json.dumps(view_state(r)))
                except Fail as e:
                    return self.send(410, json.dumps({"error": str(e)}))
            if u.path == "/api/file":
                tid, name = q.get("task", [""])[0], q.get("name", [""])[0]
                if not re.match(r"^[A-Za-z0-9_.-]+\.md$", name) or (tid and not re.match(r"^[A-Za-z0-9_-]+$", tid)):
                    return self.send(400, "bad request", "text/plain")
                p = (r.task_dir(tid) if tid else r.dir) / name
                return self.send(200, p.read_text() if p.exists() else "", "text/plain")
            if u.path == "/api/view":
                # One file for the page's viewer, read-only: `meta=1` for its name, size and kind, else its bytes.
                # SVG goes to an <img> as an image; nothing served here may run script.
                if self.headers.get("Host") not in hosts:
                    return self.send(403, json.dumps({"error": "forbidden"}))
                tid = q.get("task", [""])[0]
                p = view_path(r, q.get("path", [""])[0], tid, q.get("in", [""])[0] == "folder")
                if not p:
                    return self.send(404, json.dumps({"error": "not a file of this run"}))
                try:
                    size, kind = p.stat().st_size, view_kind(p)
                except OSError:
                    return self.send(404, json.dumps({"error": "not a file of this run"}))
                ok = kind != "binary" and size <= VIEW_CAPS["image" if kind == "image" else "text"]
                if "meta" in q:
                    return self.send(200, json.dumps({"name": p.name, "path": str(p), "size": size, "kind": kind, "ok": ok}))
                if not ok:
                    return self.send(413, json.dumps({"error": "can't preview"}))
                with open(str(p), "rb") as f:
                    body = f.read(size)
                if kind != "image":
                    body = body.decode("utf-8", "replace").encode()
                self.send_response(200)
                self.send_header("Content-Type", VIEW_IMAGES.get(p.suffix.lower(), "text/plain; charset=utf-8"))
                self.send_header("Content-Length", str(len(body)))
                self.send_header("Cache-Control", "no-store")
                self.send_header("X-Content-Type-Options", "nosniff")
                self.send_header("Content-Security-Policy", "default-src 'none'; style-src 'unsafe-inline'; sandbox")
                self.end_headers()
                return self.wfile.write(body)
            if u.path.startswith("/files/"):
                # Any file of the run folder as it is, for its own tab (video, PDF, a page an agent made) and for
                # thumbnails. By path, so a page's relative links work. Ranges, so video can seek.
                if self.headers.get("Host") not in hosts:
                    return self.send(403, json.dumps({"error": "forbidden"}))
                p = view_path(r, unquote(u.path[len("/files/"):]), "", True)
                if not p:
                    return self.send(404, json.dumps({"error": "not a file of this run"}))
                # A thumbnail names the file's mtime (`v`): a changed file gets a new URL, the rest stay cached
                return self.send_file(p, "v" in q)
            if u.path == "/api/conversation":
                # One agent's conversation from a byte offset, reduced to what the page shows. Looked up by id only,
                # and only for sessions of this run's tasks.
                sid, agent, off = (q.get(k, [""])[0] for k in ("session", "agent", "offset"))
                if not re.fullmatch(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", sid) \
                        or (agent and not re.fullmatch(r"agent-[0-9a-f]{1,64}", agent)) or not re.fullmatch(r"\d{0,15}", off):
                    return self.send(400, json.dumps({"error": "bad request"}))
                try:
                    data = r.load()
                except Fail as e:
                    return self.send(410, json.dumps({"error": str(e)}))
                if not any(s["session"] == sid for t in data["tasks"] for s in task_sessions(t)):
                    return self.send(403, json.dumps({"error": "not a session of this run"}))
                main = found.get(sid)
                main = main if main and main.is_file() else transcript(sid)
                if not main:
                    return self.send(404, json.dumps({"error": "no transcript yet"}))
                found[sid] = main
                agents = subagents(main)
                p = main.parent / main.stem / "subagents" / ("%s.jsonl" % agent) if agent else main
                if agent and (agent not in [x["agent"] for x in agents] or TRANSCRIPTS.resolve() not in p.resolve().parents):
                    return self.send(404, json.dumps({"error": "no such subagent"}))
                reply = read_conversation(p, int(off or 0))
                reply["agents"] = agents
                return self.send(200, json.dumps(reply))
            self.send(404, "{}")

        def do_POST(self):
            if self.headers.get("Origin") != origin or "application/json" not in (self.headers.get("Content-Type") or ""):
                return self.send(403, json.dumps({"error": "forbidden"}))
            body = json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0) or 0) or b"{}")
            act = urlparse(self.path).path
            try:
                if act == "/api/approve":
                    approve_with(r, body.get("answers") or [], (body.get("comment") or "").strip())
                elif act == "/api/accept":
                    do_accept(r, body["task"])
                elif act == "/api/answer":
                    do_answer(r, body["task"], body["text"])
                elif act == "/api/pause":
                    do_pause(r)
                elif act == "/api/resume":
                    do_resume(r)
                elif act == "/api/todo":
                    do_todo_done(r, int(body["n"]))
                elif act == "/api/merge":
                    start_merge(r)
                elif act == "/api/auto":
                    do_auto(r, body["on"] is True)
                elif act == "/api/say":
                    text = (body.get("text") or "").strip()
                    if not text:
                        raise Fail("write a message first")
                    return self.send(200, json.dumps({"ok": True, "reply": do_say(r, text, body.get("task") or "")}))
                elif act == "/api/reveal":
                    p = view_path(r, body["path"], body.get("task") or "", body.get("in") == "folder")
                    if not p:
                        raise Fail("not a file of this run")
                    reveal(p)
                else:
                    return self.send(404, "{}")
                self.send(200, json.dumps({"ok": True}))
            except (Fail, KeyError, ValueError, TypeError) as e:
                self.send(400, json.dumps({"error": str(e)}))

    def stop(*_):
        raise KeyboardInterrupt

    srv = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    r.set_state(viewer_pid=os.getpid(), viewer_start=proc_start(os.getpid()), viewer_port=port)
    signal.signal(signal.SIGTERM, stop)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    r.set_state(viewer_pid=0, viewer_start="")


# ---------------------------------------------------------------- before/after shots

def wait_http(url, timeout):
    end = time.time() + timeout
    while time.time() < end:
        try:
            with urlopen(url, timeout=5) as resp:
                if resp.status < 500:
                    return
        except Exception:
            pass
        time.sleep(2)
    raise Fail("the dev server at %s did not answer within %ds" % (url, timeout))


def shoot(cfg, url, out, width, height, theme, wait_ms, browser="chromium"):
    cmd = ["npx", "-y", cfg["playwright"], "screenshot", "--browser", browser, "--viewport-size", "%d,%d" % (width, height),
           "--full-page", "--wait-for-timeout", str(wait_ms), "--color-scheme", theme, url, str(out)]
    run(cmd)


def compose(cfg, rows, work, dest_base):
    gap, pad, head = 32, 32, 56
    wmax = max(w for _, w, _, _ in rows)
    parts, cur, cur_h = [], [], 0
    for row in rows:
        h = max(png_size(row[3]["before"])[1], png_size(row[3]["after"])[1]) + head + gap
        if cur and cur_h + h > 14000:
            parts.append(cur)
            cur, cur_h = [], 0
        cur.append(row)
        cur_h += h
    parts.append(cur)
    outs = []
    for i, part in enumerate(parts, 1):
        html = ["<!doctype html><meta charset=utf-8><style>body{margin:0;padding:%dpx;background:#f4f2ee;"
                "font:15px -apple-system,Segoe UI,sans-serif;color:#2a2a2a}h2{font-size:15px;margin:0 0 12px;font-weight:600}"
                ".row{margin-bottom:%dpx}.pair{display:flex;gap:%dpx;align-items:flex-start}figure{margin:0}"
                "figcaption{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#7a7268;margin-bottom:6px}"
                "img{display:block;border:1px solid #d8d2c8;background:#fff}</style>" % (pad, gap, gap)]
        for page, w, theme, files in part:
            html.append("<div class=row><h2>%s &middot; %dpx &middot; %s</h2><div class=pair>" % (page, w, theme))
            for label in ("before", "after"):
                html.append("<figure><figcaption>%s</figcaption><img src='%s' width=%d></figure>"
                            % ("Before &middot; base branch" if label == "before" else "After &middot; this run", files[label].as_uri(), w))
            html.append("</div></div>")
        page_file = work / ("compose-%d.html" % i)
        page_file.write_text("".join(html))
        dest = Path("%s%s.png" % (dest_base, "" if len(parts) == 1 else " part %d" % i))
        shoot(cfg, page_file.as_uri(), dest, 2 * wmax + gap + 2 * pad + 4, 800, "light", 300)
        outs.append(dest)
    return outs


def shots_dir(r):
    tid = os.environ.get("COORD_TASK")
    if not tid:
        ids = sorted((t["id"] for t in r.load()["tasks"] if t["id"].startswith("S")), key=lambda i: int(i[1:]) if i[1:].isdigit() else 0)
        if not ids:
            raise Fail("this run has no shots task; start one with coord shots")
        tid = ids[-1]
    d = r.task_dir(tid)
    d.mkdir(parents=True, exist_ok=True)
    return d


def cmd_shoot(a):
    r = pick_run(a.run)
    cfg, dev = r.cfg, r.cfg["dev"]
    if not dev.get("command"):
        raise Fail("config.json has no dev.command")
    data = r.load()
    base_wt = r.wt("_base")
    if not base_wt.exists():
        base_wt.parent.mkdir(parents=True, exist_ok=True)
        git(r.project, "worktree", "add", "--detach", str(base_wt), data["base"])
        setup_worktree(r, base_wt)
    # A builder shoots its own worktree; the screenshot task shoots the run branch
    own = os.environ.get("COORD_ROLE") == "builder" and os.environ.get("COORD_WT")
    run_wt = Path(os.environ["COORD_WT"]) if own else ensure_run_wt(r, data)
    servers, urls = [], {}
    (r.brain / "logs").mkdir(parents=True, exist_ok=True)
    work = shots_dir(r)
    try:
        for label, wt in (("before", base_wt), ("after", run_wt)):
            port = free_port()
            log = open(r.brain / "logs" / ("dev-%s.log" % label), "w")
            args, shell = sh(dev["command"].replace("{port}", str(port)))
            p = spawn(args, shell=shell, cwd=str(wt / dev.get("cwd", ".")),
                      stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, env=dict(os.environ, PORT=str(port)))
            servers.append(p)
            urls[label] = "http://127.0.0.1:%d" % port
        r.set_state(dev_pids=[p.pid for p in servers])
        for base in urls.values():
            wait_http(base + dev.get("ready_path", "/"), 420)
        rows = []
        shots = cfg["shots"]
        browsers = shots.get("browsers") or ["chromium"]
        for page in a.page:
            path = page if page.startswith("/") else "/" + page
            for browser in browsers:
                for w in shots["widths"]:
                    for theme in shots["themes"]:
                        files = {}
                        for label in ("before", "after"):
                            f = work / ("%s--%s--%s--%d--%s.png" % (label, slug(path, 60), browser, w, theme))
                            shoot(cfg, urls[label] + path, f, w, shots["height"], theme, shots["wait_ms"], browser)
                            files[label] = f
                        rows.append(("%s · %s" % (path, browser) if len(browsers) > 1 else path, w, theme, files))
        dest_base = work / "before-after"
        if (work / "before-after.png").exists() or (work / "before-after part 1.png").exists():
            dest_base = work / ("before-after " + dt.datetime.now().strftime("%Y-%m-%d %H.%M.%S"))
        for out in compose(cfg, rows, work, dest_base):
            print(out)
    finally:
        for p in servers:
            kill_group(p.pid)
        r.set_state(dev_pids=[])


# ---------------------------------------------------------------- cli

def main(argv=None):
    ap = argparse.ArgumentParser(prog="coord", description="Background coordinator for Claude Code agents.")
    ap.add_argument("-C", dest="chdir", metavar="<repo>", help="run as if coord was started in <repo>, like git -C")
    sub = ap.add_subparsers(dest="cmd", required=True, metavar="<command>")

    p = sub.add_parser("start", help="start a coordinator for a request")
    p.add_argument("request", nargs="*")
    p.add_argument("--request-file")
    p.add_argument("--name")
    p.add_argument("--branch", help="run branch (default coord/<name>)")
    p.add_argument("--plan-only", action="store_true", help="plan goals and tasks for later; build nothing")
    p.add_argument("--full-auto", action="store_true",
                   help="you're away: /coordinate decides for you, merges and ends the run (also a leading <full auto>)")
    p.add_argument("--quick", action="store_true", help="one builder, no planner: for one coherent change")
    p.add_argument("--size", choices=["S", "M", "L"], help="quick run: the change's size (its time box)")
    p.add_argument("--tests", choices=["on", "off"], help="quick run: on only when the owner's words ask for tests")
    p.add_argument("--ui", choices=["on", "off"], help="quick run: on when the change is to what people see")
    p.add_argument("--model", help="the planner's model, or a quick run's builder's")
    p.add_argument("--effort", choices=["low", "medium", "high", "xhigh", "max"],
                   help="the planner's effort, or a quick run's builder's")
    p.add_argument("--skip-selftest", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--no-open", action="store_true")
    p.set_defaults(fn=cmd_start)

    p = sub.add_parser("say", help="one message to the run: it answers a question, reaches a running agent, or adds work")
    p.add_argument("text", nargs="+")
    p.add_argument("--task", help="the task it is for")
    p.add_argument("--run")
    p.set_defaults(fn=cmd_say)

    p = sub.add_parser("stats", help="a run's time, cost and stages, also after it ended; --compare puts two side by side")
    p.add_argument("run", nargs="?")
    p.add_argument("--compare")
    p.add_argument("--all", action="store_true")
    p.set_defaults(fn=cmd_stats)

    p = sub.add_parser("selftest", help="check that Claude Code can start and resume Coordinator's agents (a tiny Haiku call)")
    p.set_defaults(fn=cmd_selftest)

    p = sub.add_parser("status", help="open the live page and print one line")
    p.add_argument("run", nargs="?")
    p.add_argument("--text", action="store_true", help="print details instead of opening the page")
    p.add_argument("--no-open", action="store_true")
    p.set_defaults(fn=cmd_status)

    p = sub.add_parser("wait", help="block until the run needs you or ends (zero tokens)")
    p.add_argument("run", nargs="?")
    p.add_argument("--new", action="store_true", help="don't return for what already waits on you; for while you're asked")
    p.set_defaults(fn=cmd_wait)

    p = sub.add_parser("auto", help="full auto on or off for a run and its follow-up runs: while it's on, /coordinate "
                                    "decides for you, merges and ends the run")
    p.add_argument("state", choices=["on", "off"])
    p.add_argument("run", nargs="?")
    p.set_defaults(fn=cmd_auto)

    for name, help_ in (("approve", "approve the plan, or the planner's additions to it"),
                        ("pause", "pause: agents write a note and stop"),
                        ("resume", "resume a paused or stopped run"), ("run", "build a planned run"),
                        ("restart", "restart the scheduler without stopping its agents (picks up a changed coord)")):
        p = sub.add_parser(name, help=help_)
        p.add_argument("run", nargs="?")
        p.set_defaults(fn=cmd_simple)
    for name, help_ in (("accept", "accept a task the officer keeps sending back"),
                        ("retry", "run a task again with a fresh agent"), ("stop", "stop and skip a task")):
        p = sub.add_parser(name, help=help_)
        p.add_argument("task")
        p.add_argument("--run")
        p.set_defaults(fn=cmd_simple)
    for name, help_ in (("answer", "answer a task's question"), ("tell", "send a note to a task's agent")):
        p = sub.add_parser(name, help=help_)
        p.add_argument("task")
        p.add_argument("text", nargs="+")
        p.add_argument("--run")
        p.set_defaults(fn=cmd_simple)

    p = sub.add_parser("todo", help="steps only you can do, recorded by agents; `todo done <n>` marks one done")
    p.add_argument("action", nargs="?", choices=["done"])
    p.add_argument("n", nargs="?", type=int)
    p.add_argument("--run")
    p.set_defaults(fn=cmd_todo)

    p = sub.add_parser("add", help="change the plan or add work; approved work keeps building while the planner fits it in")
    p.add_argument("text", nargs="+")
    p.add_argument("--run")
    p.set_defaults(fn=cmd_add)

    p = sub.add_parser("shots", help="before/after screenshots of this run, saved in the run's task folder")
    p.add_argument("note", nargs="*")
    p.add_argument("--run")
    p.set_defaults(fn=cmd_shots)

    p = sub.add_parser("map", help="build or refresh the project map that planners read first")
    p.add_argument("note", nargs="*", help="optional: areas to map first")
    p.add_argument("--no-open", action="store_true")
    p.set_defaults(fn=cmd_map)

    p = sub.add_parser("update", help="update Coordinator to the latest version (clone installs)")
    p.set_defaults(fn=cmd_update)

    p = sub.add_parser("list", help="coordinators in this project")
    p.set_defaults(fn=cmd_list)

    p = sub.add_parser("terminate", help="end a coordinator: stop everything, delete its task branches, internal files "
                                         "and task files; keep the run branch with its pull request")
    p.add_argument("run", nargs="?")
    p.add_argument("--purge", action="store_true",
                   help="deleting the task files is now the default; this also deletes them when unfinished work was saved")
    p.set_defaults(fn=cmd_terminate)

    p = sub.add_parser("merge", help="merge every pull request of a run and its follow-up runs, then end them all")
    p.add_argument("run", nargs="?")
    p.set_defaults(fn=cmd_merge)

    p = sub.add_parser("task", help="(agents) update your own task")
    p.add_argument("action", choices=["show", "list", "start", "review", "done", "ask", "note", "add", "edit", "remove", "design",
                                       "followup", "todo", "intent", "rest"])
    p.add_argument("target", nargs="?")
    p.add_argument("text", nargs="*")
    p.add_argument("--id")
    p.add_argument("--title")
    p.add_argument("--deps")
    p.add_argument("--files")
    p.add_argument("--size", choices=["S", "M", "L"])
    p.add_argument("--model")
    p.add_argument("--effort", choices=["low", "medium", "high", "xhigh", "max"])
    p.add_argument("--tests", choices=["on", "off"], help="on only when the owner's words ask for tests")
    p.add_argument("--ui", choices=["on", "off"], help="on when the task designs or changes what people see")
    p.add_argument("--source", help="for `design`: the guides' paths, or the owner's words")
    p.add_argument("--external", help="files outside the repo the project's rules require this task to update (absolute paths)")
    p.add_argument("--repo", help="for `followup`: the other repo's absolute path; coord starts a run there on approval")
    p.add_argument("--default", help="for `ask`: your recommended answer; the run goes on with it if the owner doesn't answer in time")
    p.add_argument("--no-default", action="store_true", help="for `ask`: only when no answer is safe without the owner")
    p.set_defaults(fn=cmd_task)

    p = sub.add_parser("audit", help="(officer) record a verdict")
    p.add_argument("verdict", choices=["approve", "notes", "revise"])
    p.add_argument("--file", required=True)
    p.set_defaults(fn=cmd_audit)

    p = sub.add_parser("_shoot")
    p.add_argument("--page", action="append", required=True)
    p.add_argument("--run")
    p.set_defaults(fn=cmd_shoot)

    p = sub.add_parser("_hook")
    p.set_defaults(fn=cmd_hook)
    p = sub.add_parser("_install")
    p.set_defaults(fn=cmd_install)
    for name, fn in (("_scheduler", cmd_scheduler), ("_viewer", cmd_viewer)):
        p = sub.add_parser(name)
        p.add_argument("--project", required=True)
        p.add_argument("--run", required=True)
        p.set_defaults(fn=fn)

    a, extra = ap.parse_known_args(argv)
    if extra and not (a.cmd == "task" and a.action == "followup"):
        ap.error("unrecognized arguments: %s" % " ".join(extra))
    if a.cmd == "task" and a.action in ("ask", "note", "followup", "todo", "intent", "rest"):
        a.text = ([a.target] if a.target else []) + a.text + extra
        if not a.text and a.action != "followup":
            ap.error("say what: coord task %s \"...\"" % a.action)
    if a.chdir:  # another repo's run without `cd`, which may ask for permission
        if not os.path.isdir(a.chdir):
            ap.error("-C: no folder %s" % a.chdir)
        os.chdir(a.chdir)
    try:
        if owner_only(a):
            raise Fail(OWNER_ONLY)
        code = a.fn(a)
        return code or 0
    except Fail as e:
        print("coord: %s" % e, file=sys.stderr)
        return 1


if __name__ == "__main__":
    if WINDOWS and not sys.flags.utf8_mode:  # run files and agent output are UTF-8, not the ANSI code page
        sys.exit(subprocess.run([sys.executable, "-X", "utf8"] + sys.argv).returncode)
    sys.exit(main())
